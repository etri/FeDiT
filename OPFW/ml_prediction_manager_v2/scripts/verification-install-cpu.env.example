# CPU-only single-node installation for Ubuntu 22.04.
# The -cpu entry scripts create .verification-install-cpu.env from this file.

AUTO_DETECT_SOURCE_PATHS=true
PREDICTION_MANAGER_ROOT=auto
PREDICTION_MANAGER_FRONTEND_ROOT=auto
INSTALL_FRONTEND=true
BUILD_FRONTEND_IMAGE=true
FRONTEND_IMAGE_TAG=union-twin-fe:verification-cpu
NODE_MAJOR_VERSION=18
PROJECTS_ONLY=false
BUILD_AUXILIARY_IMAGES=true

# CPU installs use a compact single-node resource profile.  It never rejects
# installation based on memory size or CPU core count and does not hide or
# defer services.
LOW_MEMORY_PROFILE=true
LOW_MEMORY_THRESHOLD_GIB=16
# Swap is a best-effort performance aid. Set true only when a host must fail
# if the kernel/filesystem refuses to enable the requested swap file.
CPU_SWAP_REQUIRED=false

ALLOW_EXISTING_CLUSTER=false
ALLOW_UNSUPPORTED_HOST=false
FORCE_REINSTALL=false

# CPU profile: no nvidia-smi requirement and no NVIDIA packages/workloads.
# The minimum CPU-core preflight check is intentionally disabled for CPU mode.
# Kubernetes requests/limits remain profile values for safe scheduling.
MIN_CPU_CORES=4
CHECK_MIN_CPU_CORES=false
MIN_DISK_GIB=200
REQUIRE_NVIDIA_GPU=false
INSTALL_NVIDIA_TOOLKIT=false
VERIFY_DOCKER_GPU=false
AUTO_REBOOT_AFTER_DRIVER=false
GPU_TIME_SLICES=1
PM_TENANT_RAY_GPU_WORKER_MAX_REPLICAS=0

PORTABLE_NETWORK_CONFIG=true
PORTABLE_USER_HOME_CONFIG=true
NODE_IP=auto
POD_NETWORK_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
KUBEFLOW_NODE_PORT=30080
KEYCLOAK_NODE_PORT=30081
NODEPORT_LOOPBACK_ONLY=true
REGISTRY_PORT=5000
REGISTRY_DELETE_ENABLED=true
OPEN_HOST_FIREWALL_PORTS=true
CONTAINER_DNS_SERVERS=auto
IMAGE_PULL_RETRY_ATTEMPTS=12
IMAGE_PULL_RETRY_DELAY_SECONDS=15
IMAGE_PULL_TIMEOUT_SECONDS=300

KUBERNETES_VERSION=1.30.14
CALICO_VERSION=v3.30.2
LOCAL_PATH_PROVISIONER_VERSION=v0.0.31
METRICS_SERVER_VERSION=v0.7.2
KUSTOMIZE_VERSION=v5.2.1
HELM_VERSION=v3.15.4
KUBEFLOW_VERSION=v1.9.1
KUBE_PROMETHEUS_STACK_VERSION=61.7.1

VERIFICATION_ADMIN_EMAIL=user@example.com
VERIFICATION_ADMIN_PASSWORD=auto
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=auto
POSTGRES_USER=pm_admin
POSTGRES_PASSWORD=auto
KEYCLOAK_DEX_CLIENT_SECRET=auto
PM_NIFI_INGEST_SECRET=auto

STORAGE_CLASS=local-path
REGISTRY_CONTAINER_NAME=pm-verification-registry-cpu
# `auto` resolves to ~/prediction-manager-work/.prediction-manager/cpu for
# the sudo user's home. Docker/Kubernetes system configuration remains in /etc.
INSTALL_PROFILE=cpu
INSTALL_WORK_DIR=auto
INSTALL_STATE_ROOT=auto
REGISTRY_DATA_DIR=auto
KUBEFLOW_MANIFESTS_DIR=auto
DOWNLOADS_DIR=auto
TOOLING_DIR=auto

PM_IMAGE_TAG=prediction-manager-app:verification-cpu
MLFLOW_IMAGE_TAG=mlflow-postgres:v3.11.1-pg-cpu
RAY_IMAGE_TAG=ray-mlflow:2.54.1-cpu
NIFI_IMAGE_TAG=prediction-manager-nifi-python:1.28.1-pm2-cpu
LABEL_STUDIO_IMAGE_TAG=label-studio:1.18.0-cpu
# Verified Docker Hub multi-architecture CPU image (linux/amd64 included).
RAY_BASE_IMAGE=rayproject/ray:2.54.1-py312

INSTALL_MONITORING=true
INSTALL_LABEL_STUDIO=true
PROVISION_DEFAULT_TENANT=true
ENABLE_DOCKER_SOCKET=true
WAIT_ALL_KUBEFLOW_WORKLOADS=true
LABEL_STUDIO_PUBLIC_URL=auto

# Browser-facing TCP ports are fixed to 15000-15003, 18000 and 19090.
FEDIT_PUBLIC_PORT=18000
# Private loopback/Docker-bridge port used by the FeDiT reverse proxy only.
PM_HEALTHCHECK_PORT=18100
PROMETHEUS_HEALTHCHECK_PORT=19090
NEXT_START_SCRIPT=02-start-prediction-manager-cpu.sh
