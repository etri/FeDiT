{
  "spec": {
    "strategy": {
      "type": "RollingUpdate",
      "rollingUpdate": {
        "maxSurge": 1,
        "maxUnavailable": 0
      }
    },
    "template": {
      "spec": {
        "priorityClassName": "prediction-manager-web",
        "containers": [
          {
            "name": "prediction-manager",
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "512Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "1Gi"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8000
              },
              "timeoutSeconds": 3,
              "periodSeconds": 5,
              "failureThreshold": 6
            }
          }
        ]
      }
    }
  }
}
