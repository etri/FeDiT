# Full single-node verification installation for Ubuntu 22.04.
# Copy to .verification-install.env only when overriding these defaults.

# Source paths are derived from this scripts directory. Set
# AUTO_DETECT_SOURCE_PATHS=false only when intentionally using other trees.
AUTO_DETECT_SOURCE_PATHS=true
PREDICTION_MANAGER_ROOT=auto
PREDICTION_MANAGER_FRONTEND_ROOT=auto
INSTALL_FRONTEND=true
BUILD_FRONTEND_IMAGE=true
FRONTEND_IMAGE_TAG=union-twin-fe:verification
NODE_MAJOR_VERSION=18
PROJECTS_ONLY=false
BUILD_AUXILIARY_IMAGES=true

# Existing clusters are never modified unless this is explicitly enabled.
ALLOW_EXISTING_CLUSTER=false
ALLOW_UNSUPPORTED_HOST=false
FORCE_REINSTALL=false

# Target hardware checks.
MIN_CPU_CORES=4
MIN_MEMORY_GIB=28
MIN_DISK_GIB=200
REQUIRE_NVIDIA_GPU=true
INSTALL_NVIDIA_TOOLKIT=true

# Portable network mode removes machine-specific values left by an earlier
# installation. Set it to false only when intentionally pinning an address.
PORTABLE_NETWORK_CONFIG=true
# NODE_IP=auto uses the source address of the current machine's default route.
NODE_IP=auto
POD_NETWORK_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
KUBEFLOW_NODE_PORT=30080
KEYCLOAK_NODE_PORT=30081
REGISTRY_PORT=5000

# Auto mode uses non-loopback resolvers from the current machine and falls back
# to public resolvers only when Docker exposes no usable upstream address.
CONTAINER_DNS_SERVERS=auto

# Platform versions.
KUBERNETES_VERSION=1.30.14
CALICO_VERSION=v3.30.2
LOCAL_PATH_PROVISIONER_VERSION=v0.0.31
METRICS_SERVER_VERSION=v0.7.2
KUSTOMIZE_VERSION=v5.2.1
HELM_VERSION=v3.15.4
KUBEFLOW_VERSION=v1.9.1
NVIDIA_DEVICE_PLUGIN_VERSION=0.16.2
KUBE_PROMETHEUS_STACK_VERSION=61.7.1
DCGM_EXPORTER_VERSION=3.3.1

# GPU profile is detected with nvidia-smi. In auto mode the installer divides
# the smallest detected VRAM by the target 12 GiB, clamps the result to 1..8,
# and applies that many time-sliced resources per physical GPU. Time-slicing
# does not isolate memory. Set an explicit integer to override auto sizing.
GPU_TIME_SLICES=auto
GPU_TIME_SLICE_TARGET_VRAM_GIB=12
GPU_TIME_SLICES_MIN=1
GPU_TIME_SLICES_MAX=8
# auto allows one concurrent Ray GPU worker per physical device. An explicit
# integer may consume more time-sliced slots when the workload permits it.
PM_TENANT_RAY_GPU_WORKER_MAX_REPLICAS=auto
AUTO_REBOOT_AFTER_DRIVER=false
VERIFY_DOCKER_GPU=true

# Verification identity. Generated passwords are stored outside the source
# tree at /opt/prediction-manager-verification/secrets.env (mode 600).
VERIFICATION_ADMIN_EMAIL=user@example.com
VERIFICATION_ADMIN_PASSWORD=auto
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=auto
POSTGRES_USER=pm_admin
POSTGRES_PASSWORD=auto
KEYCLOAK_DEX_CLIENT_SECRET=auto
PM_NIFI_INGEST_SECRET=auto

# Local persistent storage and image registry.
STORAGE_CLASS=local-path
REGISTRY_CONTAINER_NAME=pm-verification-registry
REGISTRY_DATA_DIR=/opt/prediction-manager-verification/registry

# Delivery images built and pushed by the installer.
PM_IMAGE_TAG=prediction-manager-app:verification
MLFLOW_IMAGE_TAG=mlflow-postgres:v3.11.1-pg
RAY_IMAGE_TAG=ray-mlflow:2.54.1
NIFI_IMAGE_TAG=prediction-manager-nifi-python:1.28.1-pm2
LABEL_STUDIO_IMAGE_TAG=label-studio:1.18.0
RAY_BASE_IMAGE=rayproject/ray:2.54.1-py312-gpu

# Install all project integrations used by the verification scenario.
INSTALL_MONITORING=true
INSTALL_LABEL_STUDIO=true
PROVISION_DEFAULT_TENANT=true
ENABLE_DOCKER_SOCKET=true
WAIT_ALL_KUBEFLOW_WORKLOADS=true
LABEL_STUDIO_PUBLIC_URL=auto

# Local validation ports used only during scripted health checks.
PM_HEALTHCHECK_PORT=18000
PROMETHEUS_HEALTHCHECK_PORT=19090

# State and logs survive a reboot so the same script can resume automatically.
INSTALL_STATE_ROOT=/opt/prediction-manager-verification
KUBEFLOW_MANIFESTS_DIR=/opt/prediction-manager-verification/kubeflow-manifests
