apiVersion: v1
kind: Namespace
metadata:
  name: keycloak
---
apiVersion: v1
kind: Secret
metadata:
  name: verification-postgres
  namespace: kubeflow
type: Opaque
stringData:
  username: "${POSTGRES_USER}"
  password: "${POSTGRES_PASSWORD}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: verification-postgres-init
  namespace: kubeflow
data:
  01-create-databases.sql: |
    CREATE DATABASE keycloak;
    CREATE DATABASE label_studio;
---
apiVersion: v1
kind: Service
metadata:
  name: pm-postgresql
  namespace: kubeflow
spec:
  selector:
    app: pm-postgresql
  ports:
    - name: postgresql
      port: 5432
      targetPort: postgresql
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: pm-postgresql
  namespace: kubeflow
spec:
  serviceName: pm-postgresql
  replicas: 1
  selector:
    matchLabels:
      app: pm-postgresql
  template:
    metadata:
      labels:
        app: pm-postgresql
      annotations:
        sidecar.istio.io/inject: "false"
    spec:
      containers:
        - name: postgresql
          image: postgres:16.4-bookworm
          ports:
            - name: postgresql
              containerPort: 5432
          env:
            - name: POSTGRES_USER
              valueFrom:
                secretKeyRef:
                  name: verification-postgres
                  key: username
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: verification-postgres
                  key: password
            - name: POSTGRES_DB
              value: prediction_manager
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          readinessProbe:
            exec:
              command:
                - sh
                - -c
                - pg_isready -U "$POSTGRES_USER" -d prediction_manager
            initialDelaySeconds: 10
            periodSeconds: 5
          resources:
            requests:
              cpu: 200m
              memory: 512Mi
            limits:
              cpu: "1"
              memory: 2Gi
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
            - name: init
              mountPath: /docker-entrypoint-initdb.d
      volumes:
        - name: init
          configMap:
            name: verification-postgres-init
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        storageClassName: "${STORAGE_CLASS}"
        accessModes:
          - ReadWriteOnce
        resources:
          requests:
            storage: 20Gi
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: verification-postgresql-allow
  namespace: kubeflow
spec:
  podSelector:
    matchLabels:
      app: pm-postgresql
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector: {}
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: keycloak
        - namespaceSelector:
            matchLabels:
              prediction-manager.io/tenant: "true"
      ports:
        - protocol: TCP
          port: 5432
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-bootstrap
  namespace: keycloak
type: Opaque
stringData:
  admin-username: "${KEYCLOAK_ADMIN_USER}"
  admin-password: "${KEYCLOAK_ADMIN_PASSWORD}"
  database-password: "${POSTGRES_PASSWORD}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: keycloak-realm
  namespace: keycloak
data:
  kubeflow-realm.json: |
    {
      "realm": "kubeflow",
      "enabled": true,
      "registrationAllowed": false,
      "loginWithEmailAllowed": true,
      "duplicateEmailsAllowed": false,
      "clients": [
        {
          "clientId": "kubeflow-dex",
          "name": "Kubeflow Dex",
          "enabled": true,
          "publicClient": false,
          "secret": "${KEYCLOAK_DEX_CLIENT_SECRET}",
          "standardFlowEnabled": true,
          "directAccessGrantsEnabled": true,
          "redirectUris": ["${KUBEFLOW_URL}/dex/callback"],
          "webOrigins": ["${KUBEFLOW_URL}"]
        }
      ],
      "users": [
        {
          "username": "${VERIFICATION_ADMIN_EMAIL}",
          "email": "${VERIFICATION_ADMIN_EMAIL}",
          "firstName": "Verification",
          "lastName": "Admin",
          "emailVerified": true,
          "enabled": true,
          "credentials": [
            {
              "type": "password",
              "value": "${VERIFICATION_ADMIN_PASSWORD}",
              "temporary": false
            }
          ]
        }
      ]
    }
---
apiVersion: v1
kind: Service
metadata:
  name: keycloak
  namespace: keycloak
spec:
  type: NodePort
  selector:
    app: keycloak
  ports:
    - name: http
      port: 8080
      targetPort: http
      nodePort: ${KEYCLOAK_NODE_PORT}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: keycloak
  namespace: keycloak
spec:
  replicas: 1
  selector:
    matchLabels:
      app: keycloak
  template:
    metadata:
      labels:
        app: keycloak
      annotations:
        sidecar.istio.io/inject: "false"
    spec:
      containers:
        - name: keycloak
          image: quay.io/keycloak/keycloak:26.0.8
          args:
            - start-dev
            - --http-port=8080
            - --http-relative-path=/auth
            - --import-realm
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: KC_BOOTSTRAP_ADMIN_USERNAME
              valueFrom:
                secretKeyRef:
                  name: keycloak-bootstrap
                  key: admin-username
            - name: KC_BOOTSTRAP_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak-bootstrap
                  key: admin-password
            - name: KC_DB
              value: postgres
            - name: KC_DB_URL
              value: jdbc:postgresql://pm-postgresql.kubeflow.svc.cluster.local:5432/keycloak
            - name: KC_DB_USERNAME
              value: "${POSTGRES_USER}"
            - name: KC_DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: keycloak-bootstrap
                  key: database-password
            - name: KC_HEALTH_ENABLED
              value: "true"
            - name: KC_HOSTNAME_STRICT
              value: "false"
            - name: KC_HTTP_ENABLED
              value: "true"
          readinessProbe:
            httpGet:
              path: /auth/realms/master
              port: http
            initialDelaySeconds: 30
            periodSeconds: 10
            failureThreshold: 18
          resources:
            requests:
              cpu: 200m
              memory: 512Mi
            limits:
              cpu: "1"
              memory: 2Gi
          volumeMounts:
            - name: realm
              mountPath: /opt/keycloak/data/import
              readOnly: true
      volumes:
        - name: realm
          configMap:
            name: keycloak-realm
