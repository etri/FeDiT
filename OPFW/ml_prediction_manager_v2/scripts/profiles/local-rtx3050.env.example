# Development/testing only; do not start the complete Kubeflow stack on 6 GiB WSL.
# Validated host WSL limits: memory=6GB, processors=4, swap=4GB.
# Run training/integration checks sequentially; stop the API/DB during Ray probes.
AUTOML_MAX_CONCURRENT_PER_NS=1
AUTOML_MAX_CONCURRENT_TRIALS=1
AUTOML_BATCH_SIZE=64
AUTOML_GPU_MEMORY_FRACTION=0.75
PM_TENANT_RAY_GPU_WORKER_MAX_REPLICAS=1
PM_TENANT_RAY_GPU_WORKER_REQUEST_MEMORY=1Gi
PM_TENANT_RAY_GPU_WORKER_LIMIT_MEMORY=3Gi
PM_TENANT_RAY_GPU_WORKER_LIMIT_CPU=1
GPU_TIME_SLICES=1
RAY_BASE_IMAGE=rayproject/ray:2.54.1-py312
RAY_IMAGE_TAG=ray-mlflow:2.54.1-gpu-cu118
# Request GPU=1, CPU=1, trial memory=0.5 GiB for small local smoke datasets.
# This is a Ray scheduling request, not a hard process memory limit.
