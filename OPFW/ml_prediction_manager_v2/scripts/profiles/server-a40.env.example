# Measured: Docker 4 CPUs, 31 GiB RAM, A40 46068 MiB, driver 535.309.01.
# Merge into the GPU installer config; do not execute this as an installer.
# Source/config/state remain under the login user's HOME.
INSTALL_PROFILE=gpu
REQUIRE_NVIDIA_GPU=true
INSTALL_NVIDIA_TOOLKIT=true
GPU_TIME_SLICES=1
PM_TENANT_RAY_GPU_WORKER_MAX_REPLICAS=1
PM_TENANT_RAY_GPU_WORKER_REQUEST_MEMORY=2Gi
PM_TENANT_RAY_GPU_WORKER_LIMIT_MEMORY=8Gi
PM_TENANT_RAY_GPU_WORKER_LIMIT_CPU=1
AUTOML_MAX_CONCURRENT_PER_NS=1
AUTOML_MAX_CONCURRENT_TRIALS=1
AUTOML_BATCH_SIZE=512
AUTOML_GPU_MEMORY_FRACTION=0.8
RAY_BASE_IMAGE=rayproject/ray:2.54.1-py312
RAY_IMAGE_TAG=ray-mlflow:2.54.1-gpu-cu118
LOW_MEMORY_PROFILE=true
# Request GPU=1, CPU=1, trial memory=4 GiB in AutoML.
# /data has 1004 GiB free, but user write access and runtime storage placement
# must be verified before installation. Do not install into the 18 GiB-free /.
# Network layout remains a capacity-review item; see GPU_DEVELOPMENT.md.
