FROM 127.0.0.1:5000/kubeflow-user-example-com/snr-per-010-mot20-pinned:v1.0
USER root
RUN python -m venv --system-site-packages /opt/snr010-env
ENV PATH="/opt/snr010-env/bin:$PATH" OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONUNBUFFERED=1
RUN python -c "import base64; open('/tmp/snr010-requirements.txt','wb').write(base64.b64decode(''))"
RUN python -m pip install --no-cache-dir numpy==2.4.4 Cython==3.2.4 setuptools wheel && python -m pip install --no-cache-dir -r /tmp/snr010-requirements.txt && python -m pip install --no-cache-dir --force-reinstall --no-deps --no-build-isolation --no-binary=cython_bbox cython_bbox==0.1.5 && python -m pip install --no-cache-dir --force-reinstall --no-deps lap==0.5.13
RUN python -c "import torch,torchvision,transformers,numpy,scipy,sklearn,lap,cython_bbox; assert lap.__version__ == '0.5.13'; print(torch.__version__,transformers.__version__,numpy.__version__,sklearn.__version__)"
RUN python -m ipykernel install --prefix=/usr/local --name snr-per-010-image --display-name "SNR-PER-010 (CUDA)"
WORKDIR /home/jovyan
USER 1000
EXPOSE 8888
