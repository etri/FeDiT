# Prediction Manager deployment values.
# Copy this file to .env and edit the values for the target environment.

# Container registry
REGISTRY_HOST=registry.example.local:5000
REGISTRY_URL=http://registry.example.local:5000

# Image tags
PM_IMAGE_TAG=prediction-manager-app:20260729-nifi-python-runtime-v1
MLFLOW_IMAGE_TAG=mlflow-postgres:v3.11.1-pg

# Application routing
DEFAULT_NAMESPACE=kubeflow-user-example-com
KUBEFLOW_URL=https://kubeflow.example.local
DATASET_INTERNAL_BASE_URL=http://istio-ingressgateway.istio-system.svc.cluster.local/prediction-manager
# Ray Job에서 직접 Service DNS 접근이 제한될 수 있으므로 내부 Istio Gateway 경유 URL을 기본값으로 사용합니다.
FEEDBACK_DATASET_INTERNAL_BASE_URL=http://istio-ingressgateway.istio-system.svc.cluster.local/prediction-manager

# Label Studio integration
LABEL_STUDIO_URL=http://label-studio.kubeflow.svc.cluster.local
# Optional. If empty, Prediction Manager tries Kubeflow header SSO with the current user email.
LABEL_STUDIO_API_TOKEN=

# Comma-separated administrator emails. Admin accounts cannot be deleted from System Management.
ADMIN_EMAILS=admin@example.com

# Tenant dashboard images
# PM_TENANT_IMAGE_REGISTRY must be reachable by Kubernetes node container runtime.
# Example: 192.168.0.166:5000, registry.example.local:5000, harbor.example.local/project
# Leave image values empty to derive them from PM_TENANT_IMAGE_REGISTRY/REGISTRY_HOST/REGISTRY_URL.
PM_TENANT_IMAGE_REGISTRY=
PM_TENANT_MLFLOW_IMAGE=
PM_TENANT_RAY_IMAGE=
PM_TENANT_RAY_CPU_WORKER_REQUEST_CPU=1
PM_TENANT_RAY_CPU_WORKER_REQUEST_MEMORY=1Gi
PM_TENANT_RAY_CPU_WORKER_LIMIT_CPU=2
PM_TENANT_RAY_CPU_WORKER_LIMIT_MEMORY=3Gi
PM_TENANT_RAY_GPU_WORKER_REQUEST_CPU=500m
PM_TENANT_RAY_GPU_WORKER_REQUEST_MEMORY=1Gi
PM_TENANT_RAY_GPU_WORKER_REQUEST_GPU=1
PM_TENANT_RAY_GPU_WORKER_LIMIT_CPU=2
PM_TENANT_RAY_GPU_WORKER_LIMIT_MEMORY=4Gi
PM_TENANT_RAY_GPU_WORKER_LIMIT_GPU=1
PM_TENANT_NIFI_IMAGE=
PM_PROVISIONER_IMAGE=

# NiFi PVC permission defaults. The custom image keeps the official uid/gid 1000.
PM_TENANT_NIFI_RUN_AS_USER=1000
PM_TENANT_NIFI_RUN_AS_GROUP=1000
PM_TENANT_NIFI_FS_GROUP=1000

# Tenant PVC StorageClass.
# Empty value means the cluster default StorageClass is used.
PM_TENANT_STORAGE_CLASS=
PM_TENANT_MLFLOW_STORAGE_CLASS=
PM_TENANT_NIFI_STORAGE_CLASS=

# Kubeflow Notebook ConfigMap integration.
# Empty PM_JUPYTER_CONFIGMAP_NAME enables automatic discovery by spawner_ui_config.yaml.
PM_JUPYTER_CONFIGMAP_NAME=
PM_JUPYTER_CONFIGMAP_NAMESPACE=kubeflow
PM_JUPYTER_WEB_APP_DEPLOYMENT=jupyter-web-app-deployment

# Runtime paths
MODEL_STORE_ROOT=/models
MODEL_STORE_BACKEND=pvc
DATASET_STORE_ROOT=/datasets
DOCKER_SOCKET=unix:///var/run/docker.sock
