package kr.udt.user.service.impl;

import java.util.List;
import java.util.Map;

import kr.udt.data.service.UdtDataWebService;
import kr.udt.data.service.impl.UdtDataWebMapper;
import kr.udt.data.service.impl.UdtDataWebServiceImpl;
import kr.udt.egovsample.service.EgovSampleService;
import kr.udt.egovsample.service.SampleDefaultVO;
import kr.udt.egovsample.service.SampleVO;
import kr.udt.egovsample.service.impl.SampleMapper;
import kr.udt.user.service.UdtUserManageService;
import egovframework.rte.fdl.cmmn.EgovAbstractServiceImpl;
import egovframework.rte.fdl.idgnr.EgovIdGnrService;
import egovframework.rte.psl.dataaccess.util.EgovMap;

import javax.annotation.Resource;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

@Service("udtUserManageService")
public class UdtUserManageServiceImpl extends EgovAbstractServiceImpl implements UdtUserManageService {
	
	private static final Logger LOGGER = LoggerFactory.getLogger(UdtUserManageServiceImpl.class);
	
	@Resource(name="udtUserManageMapper")
	private UdtUserManageMapper dao;

	@Override
	public List<EgovMap> selectUdtWebUserList(Map<String, Object> parameterMap) {
		// TODO Auto-generated method stub
		return dao.selectUdtWebUserList(parameterMap);
	}

	@Override
	public int doUserIdCheck(String userId) {
		// TODO Auto-generated method stub
		return dao.doUserIdCheck(userId);
	}

	@Override
	public int insertUdtWebUser(Map<String, Object> parameterMap) {
		return dao.insertUdtWebUser(parameterMap);
	}

	@Override
	public EgovMap selectOneUdtWebUser(Map<String, Object> parameterMap) {

		return dao.selectOneUdtWebUser(parameterMap);
	}

	@Override
	public int updateUdtWebUser(Map<String, Object> parameterMap) {
		// TODO Auto-generated method stub
		return dao.updateUdtWebUser(parameterMap);
	}

	
}
