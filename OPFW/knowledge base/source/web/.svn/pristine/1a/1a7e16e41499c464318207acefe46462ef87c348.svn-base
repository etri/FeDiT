	@Override
	public int insertNewDataset(HashMap<String, Object> param) {
		
		int reuslt = 0;
		
		// 데이터셋 마스터 테이블에 신규 데이터셋 정보 추가 (insert와 함께 param에 job_id 추가)
		reuslt += dao.insertNewDataset(param);
		// 데이터셋 상세설정정보 테이블에 신규 데이터셋에 대한 상세 정보 추가
		// 파라미터를 문자열 형태로 변환
		String apiOptionParamStr = param.get("apiOptionParam").toString();
		param.put("apiOptionParam", apiOptionParamStr);
		String selectFieldStr = param.get("selectField").toString().trim();
		selectFieldStr = selectFieldStr.replace("[", "");
		selectFieldStr = selectFieldStr.replace("]", "");
		selectFieldStr = selectFieldStr.replaceAll("\\p{Z}", ""); //모든 공백 제거
		param.put("selectField", selectFieldStr);
		reuslt += dao.insertNewDatasetLinkConfig(param);
		// 저장 테이블 생성 필드
		String[] selectFieldArray = selectFieldStr.split(",");
		param.put("selectField", selectFieldArray);
		dao.createNewDatasetTbl(param);
		
		// 데이터 수집 방식에따라 잡 프로세스 처리 순서 저장
		String jobReqTyp = param.get("jobReqTyp").toString();
		switch (jobReqTyp) {
		case "OPENAPI":
			param.put("processSn", 1); //1: 잡의 첫번째 처리내용 
			param.put("processId", 1); //1: OPENAPI 호출(원본데이터수신)
			dao.insertJobProcessSn(param);
			// 두번째 처리 내용이 있는경우 아래와 같이 추가 ... PROCESS_MST 테이블 참조
			//param.put("processSn", 2); //2: 잡의 두번째 처리내용 
			//param.put("processId", 3); //3: 데이터 가공처리
			//dao.insertJobProcessSn(param);
			break;
		case "UPLOAD_WEB":
			param.put("processSn", 1); //1: 잡의 첫번째 처리내용 
			param.put("processId", 2); //2: 수신파일 읽기
			dao.insertJobProcessSn(param);
			break;
		default:
			break;
		}
		
		return reuslt;
	}

	@Override
	public List<EgovMap> selectJobSaveTblNmList(HashMap<String, Object> param) {
		return dao.selectJobSaveTblNmList(param);
