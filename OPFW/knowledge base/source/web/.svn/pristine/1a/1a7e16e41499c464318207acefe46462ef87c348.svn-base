	@Override
	public int deleteDataset(HashMap<String, Object> param) {
		
		int reuslt = 0;
		
		// 데이터셋 상세설정정보 데이터 삭제
		reuslt += dao.deleteDatasetLinkConfig(param);
		
		// 데이터셋 마스터 테이블 데이터 삭제
		reuslt += dao.deleteDataset(param);
		
		// 잡 내부 프로세스 처리 순서 데이터 삭제
		reuslt += dao.deleteJobProcessSn(param);
		
		// 연관 저장소 테이블 삭제
		reuslt += dao.dropDatasetLinkTable(param);
		
		return reuslt;
	}

	@Override
	public int updateDataset(HashMap<String, Object> param) {
		
		int reuslt = 0;
		// 파라미터를 문자열 형태로 변환
		String apiOptionParamStr = param.get("apiOptionParam").toString();
		param.put("apiOptionParam", apiOptionParamStr);
		String selectFieldStr = param.get("selectField").toString();
		selectFieldStr = selectFieldStr.replace("[", "");
		selectFieldStr = selectFieldStr.replace("]", "");
		selectFieldStr = selectFieldStr.replaceAll("\\p{Z}", ""); 
		param.put("selectField", selectFieldStr);
		// 데이터셋 상세설정정보 데이터 수정
		reuslt += dao.updateDatasetLinkConfig(param);
		
		// 데이터셋 마스터 테이블 데이터 수정
		reuslt += dao.updateDataset(param);
		
		// 연관 저장소 테이블 수정 -> 기존 저장 필드와 비교하여 변경사항이 있으면 테이블 삭제 후 변경된 테이블 생성
		String befoFieldListStr = param.get("befoFieldList").toString();
		befoFieldListStr = befoFieldListStr.replace("[", "");
		befoFieldListStr = befoFieldListStr.replace("]", "");
		
		//모든 공백 제거
		befoFieldListStr = befoFieldListStr.replaceAll("\\p{Z}", ""); 
		
		
		String[] selectFieldArray = selectFieldStr.split(",");
		String[] befoFieldArray = befoFieldListStr.split(",");
		
		Arrays.sort(selectFieldArray);
		Arrays.sort(befoFieldArray);
		
		if(Arrays.equals(selectFieldArray, befoFieldArray)) {
			// 기존 저장 필드와 수정할 저장 필드가 동일
			return reuslt;
		} else {
		    // 테이블 삭제 후 생성
			reuslt += dao.dropDatasetLinkTable(param);
			
			param.put("selectField", selectFieldArray);
			dao.createNewDatasetTbl(param);
			return reuslt;
		}
		
	}

	
}
