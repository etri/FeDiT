<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c"      uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="form"   uri="http://www.springframework.org/tags/form" %>
<%@ taglib prefix="ui"     uri="http://egovframework.gov/ctl/ui"%>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags"%>

<script>

$(document).ready(function() {
	$('.nav-tabs li a').on('click',function(e){
		$('.nav-tabs li').removeClass('active');
		$(this).parents('li').addClass('active');
	});
});

//Add the following code if you want the name of the file appear on select
$(".custom-file-input").on("change", function() {
  var fileName = $(this).val().split("\\").pop();
  $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
});

</script>

<div class="tabs-container">
	<ul class="nav nav-tabs">
		<c:choose>
   			<c:when test="${resultMap.jobType eq 'UPLOAD_WEB'}">
   				<li class="active"><a data-toggle="tab" href="#localFile" aria-expanded="false">Local File</a></li>
   			</c:when>
   			<c:when test="${resultMap.jobType eq 'OPENAPI'}">
   				<li class="active"><a data-toggle="tab" href="#openApi" aria-expanded="true">OpenAPI</a></li>
   			</c:when>
   			<c:otherwise>
   				<li class="active"><a data-toggle="tab" href="#openApi" aria-expanded="true">OpenAPI</a></li>
        		<li class=""><a data-toggle="tab" href="#localFile" aria-expanded="false">Local File</a></li>
   			</c:otherwise>
   		</c:choose>
    </ul>
	<div class="tab-content">
	
		<!-- OpenAPI 탭 시작 -->
		<div id="openApi" class="tab-pane active">
			<form id="jobDetailViewForm" action="/udt/schedule/insertNewDataset.do">
			
				<input type="hidden" name="jobId" id="detailView_jobId" value="<c:out value="${resultMap.jobId}" default=""/>">
	
				<div class="hr-line-dashed"></div>
				
				<div class="form-group row">
					<label class="col-sm-2 col-form-label">데이터셋 종류 <br/></label>
			        <div class="col-sm-3">
			        	<select name="classNm" class="form-control" id="jobDetail_classNm" disabled>
			        		<c:choose>
			        			<c:when test="${resultMap.classNm eq 'openApiJob002'}">
			        				<option value="openApiJob001">제주일별기상정보</option>
			        				<option value="openApiJob002" selected>제주실시간교통정보</option>
			        			</c:when>
			        			<c:otherwise>
			        				<option value="openApiJob001" selected>제주일별기상정보</option>
			        				<option value="openApiJob002">제주실시간교통정보</option>
			        			</c:otherwise>
			        		</c:choose>
			        	</select>
			        </div>
			        <div class="col-sm-1">
			        	<button class="btn btn-sm btn-primary" type="button" id="btn_exClassNmChange" onclick="exClassNmChange()" style="margin-top: 2px; margin-left: -10px;" disabled>
			        		<i class="fa fa-flag"></i> 예제 파라미터 세팅
			        	</button>
			        </div>
			    </div>
				
				<div class="hr-line-dashed"></div>
				
				<div class="form-group row">
					<label class="col-sm-2 col-form-label">데이터셋명 <br/></label>
			        <div class="col-sm-3">
			        	<input type="text" id="jobDetail_jobNmKr" name="jobNmKr" disabled class="form-control" value="<c:out value="${resultMap.jobNmKr}" default=""/>">
			        </div>
			        <div class="col-sm-1"></div>
			        <label class="col-sm-2 col-form-label">보관 테이블명 <br/></label>
			        <div class="col-sm-3">
			        	<input type="text" id="jobDetail_saveTbNm" name="saveTbNm" disabled class="form-control" placeholder="보관 테이블명을 입력해주세요." value="<c:out value="${resultMap.saveTbNm}" default=""/>">
			        	<input type="hidden" class="form-control" id="tblNmDuplication" value="">
			        </div>
			        <div class="col-sm-1">
			        	<button class="btn btn-sm btn-primary" type="button" id="btn_tblNmChk" onclick="tblNmChk()" style="margin-top: 7px; margin-left: -10px;" disabled>
			        		<i class="fa fa-search"></i> 중복확인
			        	</button>
			        </div>
			    </div>
			    
				<div class="hr-line-dashed"></div>
				
				<div class="form-group row">
					<label class="col-sm-2 col-form-label">데이터 수집 확장자 <br/></label>
			        <div class="col-sm-3">
			        	<select name="udtApiRsltType" id="jobDetail_udtApiRsltType" class="form-control" disabled>
			        		<c:choose>
			        			<c:when test="${resultMap.udtApiRsltType eq 'XML'}">
			        				<option value="JSON">JSON</option>
			        				<option value="XML" selected>XML</option>
			        			</c:when>
			        			<c:otherwise>
			        				<option value="JSON" selected>JSON</option>
			        				<option value="XML">XML</option>
			        			</c:otherwise>
			        		</c:choose>
			        	</select>
			        </div>
			        <div class="col-sm-1"></div>
			        <label class="col-sm-2 col-form-label">배치주기 <i class="fa fa-question-circle isToolTip cronExplaineMark" id="" title="아이콘을 클릭해주세요."></i><small style="margin-left: 7px;">(크론표현식)</small></label>
			        <div class="col-sm-3"><input type="text" name="cronExeCycle" id="jobDetail_cronExeCycle" placeholder="배치주기를 입력해주세요." disabled class="form-control" value="<c:out value="${resultMap.cronExeCycle}" default=""/>"></div>
			    </div>
				
				<div class="hr-line-dashed"></div>
				
				<div class="form-group row">
					<label class="col-sm-2 col-form-label">요청 URL <br/></label>
			        <div class="col-sm-9"><input type="text" name="apiUrl" id="jobDetail_apiUrl" placeholder="요청 URL을 입력해주세요." disabled class="form-control" value="<c:out value="${resultMap.udtApiEndPoint}" default=""/>"></div>
			    </div>
				
				<div class="hr-line-dashed"></div>
				
				<div class="form-group row">
					<label class="col-sm-1 col-form-label">요청 변수<br/></label>
					<button class="btn btn-sm btn-info" id="addPramBtn" type="button" style="margin-right: 2px; height: 40px;" onclick="addApiOptionElement()" disabled><i class="fa fa-plus"></i> 추가</button>
					<button class="btn btn-sm btn-danger" id="removeParamBtn" type="button" style="margin-right: 15px; height: 40px;" onclick="removeApiOptionElement()" disabled><i class="fa fa-minus"></i> 삭제</button>
					<div class="col-sm-9" id="apiOptionGroup">
						<c:choose>
					  			<c:when test="${empty paramMap}">
					  				<div class="row">
									<label class="col-sm-1 col-form-label" style="text-align: center;">항목명</label>
							        <div class="col-sm-3"><input type="text" id="jobDetail_apiOptionName_default" name="apiOptionName" disabled class="form-control" value="<c:out value="${resultMap.apiUrl}" default=""/>"></div>
							        <label class="col-sm-1 col-form-label" style="text-align: center;">요청변수값</label>
							        <div class="col-sm-7"><input type="text" id="jobDetail_apiOptionValue_default" name="apiOptionValue" disabled class="form-control" value="<c:out value="${resultMap.apiUrl}" default=""/>"></div>
								</div>
					  			</c:when>
					  			<c:otherwise>
					  				<c:forEach var="apiParam" items="${paramMap}" varStatus="status">
										<div class="row">
											<label class="col-sm-1 col-form-label" style="text-align: center;">항목명</label>
								        	<div class="col-sm-3"><input type="text" id="jobDetail_apiOptionName_default" name="apiOptionName" disabled class="form-control" value="<c:out value="${apiParam.key}" default=""/>"></div>
								        	<label class="col-sm-1 col-form-label" style="text-align: center;">요청변수값</label>
								       	 	<div class="col-sm-7"><input type="text" id="jobDetail_apiOptionValue_default" name="apiOptionValue" disabled class="form-control" value="<c:out value="${apiParam.value}" default=""/>"></div>
										</div>
									</c:forEach>
					  			</c:otherwise>
					  		</c:choose>
					</div>
			  	</div>
				
				<div class="hr-line-dashed"></div>
				
				<div class="form-group row">
					<label class="col-sm-1 col-form-label">API 응답결과<br/></label>
					<div class="col-sm-1">
						<button class="btn btn-sm btn-primary" id="getApiResultBtn" type="button" style="margin-right: 15px; height: 45px;"
							onclick="getApiResult()" disabled>
						<i class="fa fa-flag"></i> API 요청
						</button>
						<img id="apiLoadingImg" alt="API 로딩" src="/images/loading_ani.gif" style="margin: 17px; display: none;">
					</div>
					
			        <div class="col-sm-4">
			        	<textarea style="height: 170px;" name="apiRsp" id="jobDetail_apiRsp" disabled class="form-control"><c:out value="${resultMap.apiRsp}" default=""/></textarea>
			        </div>
			        <div class="col-sm-5">
			        	<div id="jobDetail_apiRspTree" style="height: 170px; border: 1px solid #e5e6e7; overflow: scroll;"></div>
			        </div>
				</div>
				
				<div class="hr-line-dashed"></div>
				
				<!--
				<div class="form-group row">
					<label class="col-sm-2 col-form-label">Key 필드 선택 <br/><small>* API 요청을 통해 Key 리스트를 조회</small></label>
			        <div class="col-sm-9">
			        	<div class="row">
				        	<label class="col-sm-1 col-form-label" style="text-align: center;">데이터 Key</label>
					        <div class="col-sm-3">
					        	<select name="dataKeyNm" class="form-control" id="dataKeyNm" disabled>
					        		<c:forEach var="dataKeyNm" items="${resultMap.dataKeyNm}" varStatus="status">
					        			<option value="${dataKeyNm}"><c:out value="${dataKeyNm}"/></option>
					        		</c:forEach>
					        	</select>
					        </div>
					        <label class="col-sm-2 col-form-label" style="text-align: center;">최대 건수 Key</label>
					        <div class="col-sm-3">
					        	<select name="dataCntNm" class="form-control" id="dataCntNm" disabled>
					        		<c:forEach var="dataCntNm" items="${resultMap.dataCntNm}" varStatus="status">
					        			<option value="${dataCntNm}"><c:out value="${dataCntNm}"/></option>
					        		</c:forEach>
					        	</select>
					        </div>
						</div>
			        </div>
			    </div>
				
				<div class="hr-line-dashed"></div>
				-->
				
				<div class="form-group row">
					<input type="hidden" id="befoFieldList" name="befoFieldList" value="${fieldList}">
					<label class="col-sm-2 col-form-label">저장 필드 선택 <br/></label>
			        <div class="col-sm-9" id="selectFieldList">
			        	<c:choose>
				   			<c:when test="${not empty fieldList}">
				   				<c:forEach var="fieldNm" items="${fieldList}" varStatus="status">
					   				<div class="form-check form-check-inline">
										<input class="form-check-input" type="checkbox" id="${fieldNm}" name="selectField" value="${fieldNm}" checked="checked">
										<label class="form-check-label" for="${fieldNm}">${fieldNm}</label>
									</div>
				   				</c:forEach>
				   			</c:when>
				   			<c:otherwise>
				   			</c:otherwise>
				   		</c:choose>
			        </div>
			    </div>
				
				<div class="form-group row" style="float: right;">
					<button class="btn btn-sm btn-info" id="svaeJobBtn" type="button" style="margin-right: 50px;" onclick="createNewDataset('OPENAPI')" disabled><i class="fa fa-plus"></i> 데이터셋 저장</button>
			    </div>			
			</form>
		</div>
		<!-- OpenAPI 탭 끝 -->
		
		<!-- Local File 탭 시작 -->
		<div id="localFile" class="tab-pane">
			<form id="jobDetailViewForm2" action="/udt/schedule/insertNewDataset.do">
				<input type="hidden" name="jobId" id="detailView_jobId" value="<c:out value="${resultMap.jobId}" default=""/>">				
				<div class="hr-line-dashed"></div>			
				<div class="form-group row">
					<label class="col-sm-2 col-form-label">데이터셋 종류<br/></label>
			        <div class="col-sm-3">
			        	<select name="jobNmKr" class="form-control" id="jobDetail_jobNmKr2" disabled>
			        		<option value="uploadWebJob001" selected>건축물 연령정보</option>
			        		<option value="uploadWebJob002" selected>인천국제공항 실내 대기질</option>
			        	</select>
			        </div>
			    </div>
			    
			    <div class="hr-line-dashed"></div>
			    
			    <div class="form-group row">
					<label class="col-sm-2 col-form-label">데이터셋명 <br/></label>
			        <div class="col-sm-3">
			        	<input type="text" id="jobDetail_jobNmKr2" name="jobNmKr" disabled class="form-control" value="<c:out value="${resultMap.jobNmKr}" default=""/>">
			        </div>
			        <div class="col-sm-1"></div>
			        <label class="col-sm-2 col-form-label">보관 테이블명 <br/></label>
			        <div class="col-sm-3">
			        	<input type="text" id="jobDetail_saveTbNm2" name="saveTbNm" disabled class="form-control" placeholder="보관 테이블명을 입력해주세요." value="<c:out value="${resultMap.saveTbNm}" default=""/>">
			        	<input type="hidden" class="form-control" id="tblNmDuplication" value="">
			        </div>
			        <div class="col-sm-1">
			        	<button class="btn btn-sm btn-primary" type="button" id="btn_tblNmChk2" onclick="tblNmChk()" style="margin-top: 7px; margin-left: -10px;" disabled>
			        		<i class="fa fa-search"></i> 중복확인
			        	</button>
			        </div>
			    </div>
			    
			    <div class="hr-line-dashed"></div>
			    
			    <div class="form-group row">
			    	<label class="col-sm-2 col-form-label">데이터 업로드</label>
			    	<div class="col-sm-8 custom-file" style="left: 13px;">
					    <input type="file" class="custom-file-input" id="customFile">
					    <label class="custom-file-label" for="customFile">Choose file</label>
					</div>
			    </div>
			    
				<div class="hr-line-dashed"></div>
				
				<div class="form-group row">
					<label class="col-sm-2 col-form-label">업로드 데이터<br/></label>
			        <div class="col-sm-9">
			        	<div id="jobDetail_apiRspTree" style="height: 200px; border: 1px solid #e5e6e7; overflow: scroll;"></div>
			        </div>
				</div>
				
				<div class="hr-line-dashed"></div>
				
				<div class="form-group row" style="float: right;">
					<button class="btn btn-sm btn-info" id="svaeJobBtn" type="button" style="margin-right: 50px;" onclick="createNewDataset('UPLOAD_WEB')" disabled><i class="fa fa-plus"></i> 데이터셋 저장</button>
			    </div>
			
			</form>
		</div>
		<!-- Local File 탭 끝 -->
	</div>	
</div>