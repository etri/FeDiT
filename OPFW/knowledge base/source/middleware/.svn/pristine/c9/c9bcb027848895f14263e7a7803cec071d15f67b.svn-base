/**
 * @설명 : 파일 서비스 공통유틸(CSV,RDF,xls,txt 등의 read, write 기능을 수행한다.)
 * @작성자 : ICTWAY - 이민열 대리
 * @생성일 : 2021 12 07
 * @비고 : 스프링 컴포넌트로 등록하여 하나의 객체만 사용한다. 때문에 기능에 필요한 vo성 변수는 메소드의 파라미터로만 받고 클래스 내 멤버변수는 최대한 피한다.
 * @비고2 : 예외발생시 배치실행구현부(execute())에서 통합처리해야 모너티링에 용이하다, 때문에 finally구문에서 IO관련 Close만 실행 이후 메소드가 호출된 구현부로 예외를 다시 던진다.
 */

@Component
public class UdtFileUtil {
	
	private static final Logger LOGGER = LoggerFactory.getLogger(UdtFileUtil.class);
	
	/**
	 * @설명 : CSV 파일생성
	 * @생성일 : 2021. 12. 7.
	 * @파라미터 :  String 저장경로(젤뒤/빼고), String 파일네임(확장자빼고), List<?> csv파일값, String 파일 인코딩값, String[] 헤더, boolean 도출csv에 헤더포함여부
	 * @리턴 : String 생성파일경로(파일명포함)
	 * @비고 : 해당경로에 동일한 파일명이 있는 경우 덮어씀(기본적으로 파일명뒤에 _YYYYMMDD를 붙임, 주기가 어쩌피 최소 1주에 한번이라 덮일이유는 없으나 수동으로 배치를돌리면 당일꺼는 덮음)
	 */
	public String writeCSV(String uploadPath, String fileName, List<?> list, String encoding, String[] headers, boolean isHeaderContain) throws Exception{
		
		String returnPath = null;
		//확장자뗀거 +_yyyymmdd붙인거 +.확장자
		String saveFileNm = genSaveFileName(fileName)+".csv"; 
		String saveFullPath = uploadPath+"/"+saveFileNm;
		StringBuilder sb = null;
		FileOutputStream fos = null;
        OutputStreamWriter osw = null;
        BufferedWriter bfw = null;
		try {
			sb = new StringBuilder();
			File dirs = new File(uploadPath);
        	if(!dirs.isDirectory()) dirs.mkdirs();
			fos = new FileOutputStream(saveFullPath);
			osw = new OutputStreamWriter(fos, encoding);
			bfw = new BufferedWriter(osw);
			
			if(isHeaderContain&&headers != null && headers.length > 0){
				for(int i=0; i<headers.length; i++) {
					sb.append(headers[i]);
					if((i+1)!=headers.length)sb.append(",");
					
				}
				sb.append(System.lineSeparator());
			}
			sb = innerAppenderCsvAnd(list, sb, headers);
			
			bfw.write(sb.toString());  
			bfw.flush();
			
			File saveFile = new File(saveFullPath);
			if(saveFile.exists())returnPath=saveFullPath;
			
		} catch (Exception e) {
			e.printStackTrace();
			throw e;
		} finally{
			try {
		        if(bfw != null){fos.close();}
		        if(osw != null){osw.close();}
		        if(fos != null){bfw.close();}
		        if(sb != null){sb = null;}
			}catch(Exception e) {/*ignore*/};
		}
		return returnPath;
	}

	/**
	 * @설명 : RDF(메타데이터) 생성
	 * @생성일 : 2021. 12. 8.
	 * @파라미터 : RdfMetaCommonDTO 공통 메타데이터 , RdfMetaDatasetDTO 데이터셋마다 바뀌는 메타데이터, String 파일인코딩, String rdf저장경로(젤뒤/뺴고), String rdf파일네임(확장자제거)
	 * 			String 데이터시작일, String 데이터종료일(데이터 기준일 작성(주단위는 월요일00~금요일23, 월단위는 달의 첫쨰날~달말, 반기단위는 1월1일~6월31일)
	 * @리턴 : String 생성파일경로(파일명포함)
	 * @비고 : 해당경로에 동일한 파일명이 있는 경우 덮어씀(기본적으로 파일명뒤에 _YYYYMMDD를 붙임, 주기가 어쩌피 최소 1주에 한번이라 덮일이유는 없으나 수동으로 배치를돌리면 당일꺼는 덮음)
	 */								
	public String makeRdfFile(RdfMetaCommonDTO metaCommonDto, RdfMetaDatasetDTO metaDatasetDto
			, String encoding, String dir, String fileName, String startDateOfData, String endDateOfData) {
		
		String returnPath = null;
		//확장자뗀거 +_yyyymmdd붙인거 +.확장자
