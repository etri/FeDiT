		String saveFullPath= dir+"/"+saveFileNm;
		
		//키워드(,로구분)
		String metaKeywords= metaDatasetDto.getDcatKeyword();
		String[] metaKeywordArray = null;
		if(metaKeywords!=null)metaKeywordArray = metaKeywords.split(",");
		
		//JDOM xml(rdf)생성
		Document doc = new Document();
		
		Namespace vcard = setNameSpace("vcard", "http://www.w3.org/2006/vcard/ns#");
		Namespace dcat = setNameSpace("dcat", "http://www.w3.org/ns/dcat#");
		Namespace rdf = setNameSpace("rdf", "http://www.w3.org/1999/02/22-rdf-syntax-ns#");
		Namespace dct = setNameSpace("dct", "http://purl.org/dc/terms/");
		Namespace foaf = setNameSpace("foaf", "http://xmlns.com/foaf/0.1");
		
		Element root = new Element("RDF");
		root.addNamespaceDeclaration(vcard);
		root.addNamespaceDeclaration(dcat);
		root.addNamespaceDeclaration(rdf);
		root.addNamespaceDeclaration(dct);
		root.addNamespaceDeclaration(foaf);
		root.setNamespace(rdf);
			//addElement(부모태그,태그네임스페이스, 태그네임,태그값,속성이름,속성값,속성네임스페이스)
			Element catalog = this.addElement(root, dcat, "Catalog", null, null, null, null);
				Element dataset = this.addElement(catalog, dcat, "dataset", null, null, null, null);
					Element Dataset = this.addElement(dataset, dcat, "Dataset", null, null, null, null);
						this.addElement(Dataset, dct, "accessRights", metaDatasetDto.getDctAccessrights(), null, null, null);
						Element contactPoint = this.addElement(Dataset, dcat, "contactPoint", null, null, null, null);
							Element Individual = this.addElement(contactPoint, vcard, "Individual", null, null, null, null);
								this.addElement(Individual, vcard, "fn", metaCommonDto.getVcardFn(), null, null, null);
								this.addElement(Individual, vcard, "hasEmail", null, "resource", "mailto:"+metaCommonDto.getVcardHasemail(), rdf);
								this.addElement(Individual, vcard, "hasTelephone", null, "resource", "tel:"+metaCommonDto.getVcardHastelephone(), rdf);
			
						Element creator = this.addElement(Dataset, dct, "creator", null, null, null, null);
							Element Organization = this.addElement(creator, foaf, "Organization", null, null, null, null);
								this.addElement(Organization, foaf, "name", metaCommonDto.getFoafName(), null, null, null);
								this.addElement(Organization, foaf, "homepage", null, "resource", metaCommonDto.getFoafHomepage(), rdf);
								this.addElement(Organization, foaf, "mbox", metaCommonDto.getFoafMbox(), null, null, null);
								this.addElement(Organization, foaf, "phone", metaCommonDto.getFoafPhone(), null, null, null);
			
						this.addElement(Dataset, dct, "description", metaDatasetDto.getDctDescription(), null, null, null);
						this.addElement(Dataset, dct, "title", metaDatasetDto.getDctTitle(), null, null, null);
						this.addElement(Dataset, dct, "issued", "데이터파일 업로드 시각", "datatype", "http://www.w3.org/2001/XMLSchema#dateTime", rdf);
						this.addElement(Dataset, dct, "modified", "데이터파일 업로드 시각", "datatype", "http://www.w3.org/2001/XMLSchema#dateTime", rdf);
						this.addElement(Dataset, dct, "language", null, "resource", "http://id.loc.gov/vocabulary/iso639-1/ko", rdf);
						Element publisher = this.addElement(Dataset, dct, "publisher", null, null, null, null);
							Element Organization2 = this.addElement(publisher, foaf, "Organization", null, null, null, null);
								this.addElement(Organization2, foaf, "name", metaCommonDto.getFoafName(), null, null, null);
								this.addElement(Organization2, foaf, "homepage", null, "resource", metaCommonDto.getFoafHomepage(), rdf);
								this.addElement(Organization2, foaf, "mbox", metaCommonDto.getFoafMbox(), null, null, null);
								this.addElement(Organization2, foaf, "phone", metaCommonDto.getFoafPhone(), null, null, null);
						this.addElement(Dataset, dct, "identifier", metaDatasetDto.getDctIdentifier(), null, null, null);
						this.addElement(Dataset, dcat, "theme", metaDatasetDto.getDcatTheme(), null, null, null);
						this.addElement(Dataset, dct, "type", "dataset", null, null, null);
				if(metaKeywordArray!=null) {
					for(String keyword : metaKeywordArray) {
						this.addElement(Dataset, dcat, "keyword", keyword, null, null, null);
					}
				}
						this.addElement(Dataset, dcat, "landingPage", metaDatasetDto.getDcatLandingpage(), null, null, null);
						this.addElement(Dataset, dct, "license", metaCommonDto.getDctLicense(), null, null, null);
						this.addElement(Dataset, dct, "rights", metaCommonDto.getDctRights(), null, null, null);
						this.addElement(Dataset, dcat, "spatialResolutionInMeters", null, null, null, null);
						this.addElement(Dataset, dcat, "temporalResolution", null, null, null, null);
						this.addElement(Dataset, dct, "accrualPeriodicity", null, null, null, null);
						this.addElement(Dataset, dct, "spatial", null, null, null, null);
						Element temporal = this.addElement(Dataset, dct, "temporal", null, null, null, null);
							Element PeriodOfTime = this.addElement(temporal, dcat, "PeriodOfTime", null, null, null, null);
								this.addElement(PeriodOfTime, dct, "startDate", startDateOfData, null, null, null);
								this.addElement(PeriodOfTime, dct, "endDate", endDateOfData, null, null, null);
					    this.addElement(Dataset, null, "version", null, null, null, null);
					    this.addElement(Dataset, null, "versionDescription", null, null, null, null);
					    this.addElement(Dataset, null, "priceInfo", metaDatasetDto.getPriceinfo(), null, null, null);
					    this.addElement(Dataset, null, "qualityInfo", null, null, null, null);
					    Element distribution = this.addElement(Dataset, dcat, "distribution", null, null, null, null);
					    	Element Distribution = this.addElement(distribution, dcat, "Distribution", null, null, null, null);
					    		this.addElement(Distribution, dcat, "accessService", null, null, null, null);
					    		this.addElement(Distribution, dct, "accessURL", null, "resource", "https://diamond-e.kr/", rdf);
					    		this.addElement(Distribution, dcat, "byteSize", null, null, null, null);
					    		this.addElement(Distribution, dcat, "compressFormat", null, null, null, null);
					    		this.addElement(Distribution, dcat, "downloadURL", null, null, null, null);
					    		this.addElement(Distribution, dcat, "mediaType", "https://www.iana.org/assignments/media-types/text/csv", null, null, null);
					    		this.addElement(Distribution, dcat, "spatialResolutionInMeters", null, null, null, null);
					    		this.addElement(Distribution, dcat, "temporalResolution", null, null, null, null);
					    		this.addElement(Distribution, dcat, "accessRights", metaDatasetDto.getDctAccessrights(), null, null, null);
					    		this.addElement(Distribution, dcat, "description", metaDatasetDto.getDctDescription(), null, null, null);
					    		this.addElement(Distribution, dcat, "format", "csv", null, null, null);
					    		this.addElement(Distribution, dct, "issued", "2021-01-12 17:30:33.727+0900", "datatype", "http://www.w3.org/2001/XMLSchema#dateTime", rdf);
					    		this.addElement(Distribution, dcat, "license", metaCommonDto.getDctLicense(), null, null, null);
					    		this.addElement(Distribution, dct, "modified", "2021-01-12 17:30:33.727+0900", "datatype", "http://www.w3.org/2001/XMLSchema#dateTime", rdf);
					    		this.addElement(Distribution, dcat, "rights", metaCommonDto.getDctRights(), null, null, null);
					    		this.addElement(Distribution, dcat, "title", metaDatasetDto.getDctTitle(), null, null, null);
					    		this.addElement(Distribution, null, "version", null, null, null, null);
					    		this.addElement(Distribution, null, "versionDescription", null, null, null, null);
					    		this.addElement(Distribution, null, "priceInfo", null, null, null, null);
					    		this.addElement(Distribution, null, "qualityInfo", null, null, null, null);
					    		this.addElement(Distribution, dcat, "accessURL", "-", null, null, null);
					    this.addElement(Dataset, dct, "subtitle", metaDatasetDto.getDctTitle(), null, null, null);
					//</dcat:Dataset>
				//</dcat:dataset>
		    //</dcat:Catalog>
		//</rdf:RDF> 후 ㅈㄴ빡샘
		doc.setRootElement(root);
		 
		FileOutputStream fos = null;
		File file = null;
		 
	    try{
	    	
			File dirs = new File(dir);
			if(!dirs.isDirectory()) dirs.mkdirs();
			file = new File(saveFullPath);
			fos = new FileOutputStream(file);
			 
			XMLOutputter serializer = new XMLOutputter();
			Format f = serializer.getFormat().setExpandEmptyElements(true);
			f.setEncoding(encoding);
			f.setIndent(" ");                                            
			f.setLineSeparator("\r\n");                                  
			f.setTextMode(Format.TextMode.TRIM);                         
			serializer.setFormat(f);                                              
			serializer.output(doc, fos);
			fos.flush();
			
			File saveFile = new File(saveFullPath);
			if(saveFile.exists())returnPath=saveFullPath;
			
	    }catch(Exception e){
		}finally{try{ if(fos!=null) fos.close(); }catch(IOException ignore){}}
	    
		return returnPath;
	}
	
	/**
	 * @설명 : CSV BODY채우기
	 * @생성일 : 2021. 12. 7.
	 * @파라미터 : List<?> 내용리스트(vo,map,단일객체 우선 map만 순서처리가능, 나머지는 추가개발해야댐), StringBuilder 스트링빌더
	 * @리턴 : StringBuilder
	 * @비고 : 
	 */
	private StringBuilder innerAppenderCsvAnd(List<?> list, StringBuilder sb, String[] headers) throws Exception{
		for(Object T : list){
			if(T instanceof String || T instanceof Integer || T instanceof Boolean || T instanceof Character){ //단일 
				sb.append(T.toString());
				sb.append(System.lineSeparator());
			} else if(T instanceof HashMap){ //맵 형태
				@SuppressWarnings("unchecked")
				Map<String,Object> map = (HashMap<String, Object>)T;
				
				for(int i=0; i<headers.length; i++) {
					Object value = map.get(headers[i].toLowerCase());
					//,있는값은 ""로 감싸기
					if(value instanceof String && ((String)value).contains(",")){
						//근데 또 재료데이터에 ""넣어서 보낸애들있음..아놔 이경우 ""ㅇㅇ,ㅇㅇ"" 일케되면서 csv열면 깨져있음
						if(!(((String)value).startsWith("\"")&&((String)value).endsWith("\""))) {
							value = "\""+((String)value)+"\"";
						}
					}
					if(value==null)value="";
					sb.append(value);
					if((i+1)!=headers.length)sb.append(",");		
				}
				sb.append(System.lineSeparator());
			} else {//일반 vo형태
				BeanInfo info = Introspector.getBeanInfo(T.getClass());
				for(PropertyDescriptor pd : info.getPropertyDescriptors()){
					Method reader = pd.getReadMethod();
					if(reader != null && (!pd.getName().equals("class"))){
						Object value = reader.invoke(T);
						if(value == null){ continue; }
						sb.append(value.toString());
					}
				}
				sb.append(System.lineSeparator());
			}
		}
		return sb;
	}
	
	
	/**
	 * @설명 : 파일명_YYYYMMDD
	 * @생성일 : 2021. 12. 7.
	 * @파라미터 : String 파일명
	 * @리턴 : String 변환파일명
	 * @비고 : 교빅 파일 업로드 규칙 > 상품코드_YYYYMMDD.csv,상품코드_YYYYMMDD.rdf
	 */
	private String genSaveFileName(String orgFileName) {
        String fileName=orgFileName+"_";
        SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMdd");
        Calendar c1 = Calendar.getInstance();
        String strToday = sdf.format(c1.getTime());
        fileName += strToday;        

        return fileName;
    }
	
	public String genMilitimeSaveFileName(String orgFileName) {
        String fileName="";
        Calendar calendar = Calendar.getInstance();
        fileName += calendar.get(Calendar.YEAR);
        fileName += calendar.get(Calendar.MONTH);
        fileName += calendar.get(Calendar.DATE);
        fileName += calendar.get(Calendar.HOUR);
        fileName += calendar.get(Calendar.MINUTE);
        fileName += calendar.get(Calendar.SECOND);
        fileName += calendar.get(Calendar.MILLISECOND);
        fileName += "_"+orgFileName;

        return fileName;
    }
	
	public String getExtName(String orgFileName) {
        return orgFileName.substring(orgFileName.lastIndexOf(".")+1);
    }
	
	public String getFileNameWithoutExtName(String orgFileName) {
		return orgFileName.substring(0,orgFileName.lastIndexOf("."));
    }
	
	public String getOnlyFileNm(String containsFileNmPath) {
		return containsFileNmPath.substring(containsFileNmPath.lastIndexOf("/")+1);
    }
	
	public String getOnlyPath(String containsFileNmPath) {
		return containsFileNmPath.substring(0,containsFileNmPath.lastIndexOf("/"));
    }
    
    public String genYYYYMMDDDirectory() {
    	  Calendar cal = Calendar.getInstance();
    	  String dateString;
    	  dateString = String.format("%04d/%02d/%02d/", cal.get(Calendar.YEAR), cal.get(Calendar.MONTH) + 1, cal.get(Calendar.DAY_OF_MONTH));
    	  return dateString;
    }
    
	/**
	 * @설명 : 유닉스형태 파일을 일반 dos형태 파일로 바꾸는 함수(인코딩방지)
	 * @생성일 : 2021. 12. 7.
	 * @파라미터 : String 파일 풀경로 (파일이름포함)
	 * @리턴 : void
	 * @비고 : 
	 */
	public void unix2dos(String fname) throws Exception {
		try {
			File f1 = new File(fname);
			File f2 = new File(fname+".csv");
			BufferedInputStream inp = new BufferedInputStream(new FileInputStream(f1));
			BufferedOutputStream outp = new BufferedOutputStream(new FileOutputStream(f2));
			int c;
			while ((c = inp.read()) > 0) {
				if (c == '\n')
					outp.write('\r');
				outp.write(c);
			}
			inp.close();
			outp.close();
			if (!f1.delete()) {
				LOGGER.error("파일[ %s ]은 읽기전용이기에 저장 할 수 없습니다.\n", fname);
				return;
			}
			f2.renameTo(f1);
			
		} catch (Exception e) {
			e.printStackTrace();
			throw e;
		}
	}	
	

	
	/**
	 * @설명 : JDOM xml 엘리먼트 추가
	 * @생성일 : 2021. 12. 8.
	 * @파라미터 : Element 부모태그, Namespace 태그네임스페이스, String 태그네임, String 태그값, String 속성이름, String 속성값, Namespace 속성네임스페이스)
	 * @리턴 : Element 생성된 태그
	 * @비고 : 해당 없는건 null로 넘김
	 */
	private Element addElement(Element parent, Namespace ns, String eleName, String eleVal, String propName, String propVal, Namespace pns) {
		Element el = new Element(eleName);
		if(ns!=null) el.setNamespace(ns);
		else el.setNamespace(Namespace.NO_NAMESPACE);
		parent.addContent(el);
		if(eleVal!=null)el.setText(eleVal);
		if(propName!=null) {
			
			if(pns!=null) el.setAttribute(propName, propVal,pns);
			else el.setAttribute(propName, propVal);  
		}
		return el;
	}
	
	public Namespace setNameSpace(String xmlns, String url) {
		return Namespace.getNamespace(xmlns, url);
	}
	
	
	
	/**
	 * @설명 : 파일이동
	 * @생성일 : 2021. 12. 8.
	 * @파라미터 : String 이동후 파일명, String 이동시킬 원본파일의풀경로(파일명포함), String 이동시킬 경로(젤뒤/포함) 
	 * @리턴 : 이동결과
	 * @비고 : 
	 */
	public boolean moveFile(String fileName, String srcFileFullPath, String dstFilePath) throws Exception{  
		
		boolean result = false;
		
		File dir = new File(dstFilePath); 
		if (!dir.exists())dir.mkdirs(); 
		
		File file =new File(srcFileFullPath);  
		
		if(file.renameTo(new File(dstFilePath+fileName))) {
			result=true;
		}else{
			throw new IOException("파일이동중 오류가 발생하였습니다. 입력파일:["+srcFileFullPath+"], 복사경로:["+dstFilePath+"/"+fileName+"]");
		}; 
			
		return result;
	}    

	/**
	 * @설명 : txt파일 읽기
	 * @생성일 : 2021. 06. 17.
	 * @파라미터 : String 파일풀경로(파일명포함), String 파일 내 구분자 
	 * @리턴 : List<String[]>데이터로우(배열) 리스트
	 * @비고 : 
	 */
	public List<String[]> readTextFile(String fullFilePath, String separator){
    	
		File file = null;
		BufferedReader br = null;
        
        List<String[]> dataList = new ArrayList<String[]>();    
        
        int rowCount =0;
        
        try {
        	
        	file=new File(fullFilePath);
        	br=new BufferedReader(new InputStreamReader(new FileInputStream(file),"euc-kr"));

        	String line=null;
        	while((line=br.readLine()) != null){
        		 String row = line;
                 rowCount++;
                 String[] rowCols = row.split(separator,-1);
                 dataList.add(rowCols);
        	}
          
        } catch (IOException e) {
        	LOGGER.error("에러발생");
        } catch(NullPointerException e) {
			LOGGER.error("에러발생");
		}
 
        finally {        	
            if (br != null) {try {br.close();} catch (IOException e) {LOGGER.error("에러발생");}}
        }
        
        return dataList;
    }
}
