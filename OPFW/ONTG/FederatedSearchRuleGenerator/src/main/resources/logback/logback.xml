<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<property name="LOG_DIR"
		value="/hdd/Federated/SearchRule" />

	<appender name="CONSOLE"
		class="ch.qos.logback.core.ConsoleAppender">
		<encoder
			class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>▶%-5level %d{HH:mm:ss:.SSS} [%thread] %logger[%method:%line]
				- %msg%n</pattern>
		</encoder>
	</appender>

	<appender name="ROLLING-FILE"
		class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_DIR}/ruleGenerator.log</file>
		<encoder
			class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>▶%-5level %d{HH:mm:ss:.SSS} [%thread] %logger[%method:%line]
				- %msg%n</pattern>
		</encoder>
		<rollingPolicy
			class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${LOG_DIR}/ruleGenerator.%d{yyyy-MM-dd}_%i.log
			</fileNamePattern>
			<timeBasedFileNamingAndTriggeringPolicy
				class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<maxFileSize>256MB</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>
		</rollingPolicy>
	</appender>

	<root level="ERROR">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</root>

	<logger name="org.apache.ibatis" level="ERROR"
		additivity="false">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</logger>

	<logger name="org.springframework" level="ERROR"
		additivity="false">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</logger>


	<logger name="com.federated.searchRule.restfulApi.config"
		level="ERROR" additivity="false">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</logger>

	<logger name="com.federated.searchRule.restfulApi.controller"
		level="ERROR" additivity="false">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</logger>

	<logger name="com.federated.searchRule.restfulApi.schedule"
		level="ERROR" additivity="false">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</logger>

	<logger name="com.federated.searchRule.restfulApi.exception"
		level="ERROR" additivity="false">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</logger>

	<logger name="com.federated.searchRule.restfulApi.service"
		level="ERROR" additivity="false">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</logger>

	<logger name="com.federated.searchRule.restfulApi.util"
		level="ERROR" additivity="false">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</logger>

	<logger name="com.federated.searchRule.restfulApi.dto"
		level="ERROR" additivity="false">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</logger>

	<logger name="com.federated.searchRule.restfulApi.vo"
		level="ERROR" additivity="false">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</logger>

	<logger name="com.federated.searchRule.restfulApi.dao"
		level="ERROR" additivity="false">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="ROLLING-FILE" />
	</logger>

	<logger name="com.zaxxer.hikari" level="ERROR" />
	<logger name="com.zaxxer.hikari.HikariConfig" level="ERROR" />

</configuration>