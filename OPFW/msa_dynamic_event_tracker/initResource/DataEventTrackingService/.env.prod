spring.datasource.hikari.jdbc-url=jdbc:mysql://{serverIp}:{dbPort}/dataEventTrackings?autoCommit=false&useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC&autoReconnect=true
spring.datasource.hikari.username={userId}
spring.datasource.hikari.password={userPw}
spring.security.user.name={eurekaId}
spring.security.user.password={eurekaPw}
eureka.client.serviceUrl.defaultZone=http://{eurekaId}:{eurekaPw}@\{serverIp}:{eurekaPort}/eureka/

spring.rabbitmq.host=rabbitmq_detrck
spring.rabbitmq.port=5672
spring.rabbitmq.username=guest
spring.rabbitmq.password=guest
rabbitmq.exchange.name=federate.tracking

spring.kafka.bootstrap-servers:{kafkaIp}:9092

script.engine.name=nashorn
