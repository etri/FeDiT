<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper   PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.jw.twin.repository.db.dataCategoryDesc.mapper.DataCategoryDescMapper">

	<!--	 common 	-->
    <sql id="sort">
      <if test="null != sort and null != sortOrd"> order by ${sort} ${sortOrd}, category ${sortOrd} </if>
    </sql>

    <sql id="paging">
      <if test="null != pagingYn and pagingYn == true" >
        limit #{start}, #{length}
      </if>
    </sql>

	<!--	 selectList 	-->
	<select id="selectList" parameterType="dataCategoryDescSearch" resultType="dataCategoryDesc">
		select
			*
		from
			data_category_desc
		<!--<where>-->
			<!--<if test="null != category" >                 and category = #{category}                         </if>-->
			<!--<if test="null != name" >                     and name = #{name}                                 </if>-->
			<!--<if test="null != icon" >                     and icon = #{icon}                                 </if>-->
			<!--<if test="null != iconFileId" >               and icon_file_id = #{iconFileId}                   </if>-->
			<!--<if test="null != description" >              and description = #{description}                   </if>-->
			<!--<if test="null != regId" >                    and REG_ID = #{regId}                              </if>-->
			<!--<if test="null != regDt" >                    and REG_DT = #{regDt}                              </if>-->
			<!--<if test="null != delId" >                    and DEL_ID = #{delId}                              </if>-->
			<!--<if test="null != delDt" >                    and DEL_DT = #{delDt}                              </if>-->
		<!--</where>-->
		<where>
			DEL_DT IS NULL
			<if test="null != category" >                     and category = #{category}                        </if>
			<if test="null != name" >                         and name like CONCAT('%', #{name}, '%')           </if>
			<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
			<if test="null != startRegDt" >                   and REG_DT <![CDATA[ >= ]]> #{startRegDt}         </if>
			<if test="null != endRegDt" >                     and REG_DT <![CDATA[ < ]]> #{endRegDt}            </if>
		</where>
		<!--		where	-->
		<!--		DEL_ID IS NULL	-->
		<include refid = "sort"/>
		<include refid = "paging"/>
	</select>

	<!--	 selectListNullCheck 	-->
	<select id="selectListNullCheck" parameterType="dataCategoryDescSearch" resultType="dataCategoryDesc">
		select
			*
		from
			data_category_desc
		where
			DEL_DT IS NULL
			<foreach collection="isNotNull" item="value"
					open="and (" separator="and " close=")">
				${value} is not null
			</foreach>
			<foreach collection="isNull" item="value"
					open="and (" separator="and " close=")">
				${value} is null
			</foreach>
			<if test="null != category" >                     and category = #{category}                        </if>
			<if test="null != name" >                         and name like CONCAT('%', #{name}, '%')           </if>
			<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
			<if test="null != startRegDt" >                   and REG_DT <![CDATA[ >= ]]> #{startRegDt}         </if>
			<if test="null != endRegDt" >                     and REG_DT <![CDATA[ < ]]> #{endRegDt}            </if>
		<!--		where	-->
		<!--		DEL_ID IS NULL	-->
		<include refid = "sort"/>
		<include refid = "paging"/>
	</select>

	<!--	 select 	-->
	<select id="select" parameterType="dataCategoryDescSearch" resultType="dataCategoryDesc">
		select
			*
		from
			data_category_desc
		<where>
			DEL_DT IS NULL
			<if test="null != category" >                     and category = #{category}                        </if>
			<if test="null != name" >                         and name like CONCAT('%', #{name}, '%')           </if>
			<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
			<if test="null != startRegDt" >                   and REG_DT <![CDATA[ >= ]]> #{startRegDt}         </if>
			<if test="null != endRegDt" >                     and REG_DT <![CDATA[ < ]]> #{endRegDt}            </if>
		</where>
	</select>

	<!--	 selectBy 	-->

	<!--	 count 	-->
	<select id="count" parameterType="dataCategoryDescSearch" resultType="java.lang.Integer">
		select
			COUNT( * )
		from (
				select 1 from data_category_desc
				<where>
					DEL_DT IS NULL
					<if test="null != category" >                     and category = #{category}                        </if>
					<if test="null != name" >                         and name like CONCAT('%', #{name}, '%')           </if>
					<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
					<if test="null != startRegDt" >                   and REG_DT <![CDATA[ >= ]]> #{startRegDt}         </if>
					<if test="null != endRegDt" >                     and REG_DT <![CDATA[ < ]]> #{endRegDt}            </if>
				</where>
				<include refid = "sort"/>
				<include refid = "paging"/>
		) t
	</select>

	<!--	 countNullCheck 	-->
	<select id="countNullCheck" parameterType="dataCategoryDescSearch" resultType="java.lang.Integer">
		select
			COUNT( * )
		from (
				select 1 from data_category_desc
				where
					DEL_DT IS NULL
					<foreach collection="isNotNull" item="value"
							open="and (" separator="and " close=")">
						${value} is not null
					</foreach>
					<foreach collection="isNull" item="value"
							open="and (" separator="and " close=")">
						${value} is null
					</foreach>
					<if test="null != category" >                     and category = #{category}                        </if>
					<if test="null != name" >                         and name like CONCAT('%', #{name}, '%')           </if>
					<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
					<if test="null != startRegDt" >                   and REG_DT <![CDATA[ >= ]]> #{startRegDt}         </if>
					<if test="null != endRegDt" >                     and REG_DT <![CDATA[ < ]]> #{endRegDt}            </if>
				<include refid = "sort"/>
				<include refid = "paging"/>
		) t
	</select>

	<!--	 insert 	-->
	<insert id="insert" parameterType="dataCategoryDesc" >
		insert data_category_desc
		<set>
			REG_ID = #{regId},
			REG_DT = SYSDATE(),
			<if test="null != category" >                category = #{category},                       </if>
			<if test="null != name" >                    name = #{name},                               </if>
			<if test="null != icon" >                    icon = #{icon},                               </if>
			<if test="null != iconFileId" >              icon_file_id = #{iconFileId},                 </if>
			<if test="null != description" >             description = #{description},                 </if>
		</set>
	</insert>

	<!--	 update 	-->
	<update id="update" parameterType="dataCategoryDesc">
		update data_category_desc
		<set>
			<if test="null != name" >                    name = #{name},                              </if>
			<if test="null != icon" >                    icon = #{icon},                              </if>
			<if test="null != iconFileId" >              icon_file_id = #{iconFileId},                </if>
			<if test="null != description" >             description = #{description},                </if>
			<if test="null != regDt" >                   REG_DT = #{regDt},                           </if>
		</set>
		<where>
			<if test="null != category" >                     and category = #{category}                        </if>
		</where>
	</update>

	<!--	 delete 	-->
	<update id="delete" parameterType="dataCategoryDesc">
		delete from data_category_desc
		<where>
			<if test="null != category" >                     and category = #{category}                        </if>
		</where>
	</update>

	<!--	 deleteSoft 	-->
	<update id="deleteSoft" parameterType="dataCategoryDesc">
		update data_category_desc set 
			DEL_ID = #{delId},
			DEL_DT = SYSDATE()
		<where>
			<if test="null != category" >                     and category = #{category}                        </if>
		</where>
	</update>

	<!--	 etc 	-->
	<insert id="insertList" parameterType="dataCategoryDesc">
		insert into data_category_desc
		(
			category,
			name,
			icon,
			icon_file_id,
			description,
			REG_ID,
			REG_DT,
			DEL_ID,
			DEL_DT)
		values
		<foreach collection="list" item="item" separator=",">
		(
			#{item.category},
			#{item.name},
			#{item.icon},
			#{item.iconFileId},
			#{item.description},
			#{item.regId},
			#{item.regDt},
			#{item.delId},
			#{item.delDt})
		</foreach>
		on duplicate key update
			category=values(category),
			name=values(name),
			icon=values(icon),
			icon_file_id=values(icon_file_id),
			description=values(description),
			REG_ID=values(REG_ID),
			REG_DT=values(REG_DT),
			DEL_ID=values(DEL_ID),
			DEL_DT=values(DEL_DT)
	</insert>
</mapper>