<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper   PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.jw.twin.repository.client.dbExt.dataCategoryDescExt.mapper.DataCategoryDescMapperExt">

    <select id="selectListWithIconFileInfo" parameterType="dataCategoryDescSearch" resultType="CamelHashMap">
        select TD.*, TF.SAVE_PATH as save_path, TF.FILE_NM as icon_file_name, TF.SAVE_FILE_NM as icon_save_file_name, CONCAT(TF.SAVE_PATH,TF.SAVE_FILE_NM) as icon_file_path
        from (select * from data_category_desc where DEL_ID is null) as TD
        left join JCMS_FILE_ITEM as TF on TD.icon_file_id = TF.ITEM_ID
        <where>
            DEL_DT IS NULL
            <if test="null != category" >                     and category = #{category}                        </if>
            <if test="null != name" >                         and name like CONCAT('%', #{name}, '%')           </if>
            <if test="null != regId" >                        and REG_ID = #{regId}                             </if>
            <if test="null != startRegDt" >                   and REG_DT <![CDATA[ >= ]]> #{startRegDt}         </if>
            <if test="null != endRegDt" >                     and REG_DT <![CDATA[ < ]]> #{endRegDt}            </if>
        </where>
        <include refid = "net.jw.twin.repository.db.dataCategoryDesc.mapper.DataCategoryDescMapper.sort"/>
        <include refid = "net.jw.twin.repository.db.dataCategoryDesc.mapper.DataCategoryDescMapper.paging"/>
    </select>

</mapper>