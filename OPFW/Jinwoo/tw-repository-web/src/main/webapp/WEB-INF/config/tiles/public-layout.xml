<tiles-definitions>
    <definition name="public-layout" template="/WEB-INF/view/tilesLayout/onePage/layout.jsp">
        <put-attribute name="content"   value="" />
    </definition>

    <definition name="public/*" extends="public-layout">
        <put-attribute name="content"   value="/WEB-INF/view/public/{1}.jsp" />
    </definition>
    <definition name="public/*/*" extends="public-layout">
        <put-attribute name="content"   value="/WEB-INF/view/public/{1}/{2}.jsp" />
    </definition>
    <definition name="public/*/*/*" extends="public-layout">
        <put-attribute name="content"   value="/WEB-INF/view/public/{1}/{2}/{3}.jsp" />
    </definition>
    <definition name="public/*/*/*/*" extends="public-layout">
        <put-attribute name="content"   value="/WEB-INF/view/public/{1}/{2}/{3}/{4}.jsp" />
    </definition>
    
