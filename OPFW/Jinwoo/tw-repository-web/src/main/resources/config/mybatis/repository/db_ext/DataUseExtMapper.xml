<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper   PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.jw.twin.repository.client.dbExt.dataUseExt.mapper.DataUseMapperExt">
    <sql id="sort">
        <if test="null != sort and null != sortOrd"> order by ${sort} ${sortOrd}, id ${sortOrd} </if>
    </sql>

    <sql id="paging">
        <if test="null != pagingYn and pagingYn == true" >
            limit #{start}, #{length}
        </if>
    </sql>

    <select id="countAlreadyRequested" parameterType="DataUseSearch" resultType="java.lang.Integer">
        select
            COUNT( * )
        from (
            select * from data_use
                     WHERE DEL_DT is NULL and data_id = #{dataId}  and REG_ID = #{regId} and (expire_time is null or expire_time <![CDATA[ < ]]> SYSDATE())
        ) t
    </select>

    <select id="selectDataUseSearchExtList" parameterType="DataUseSearchExt" resultType="CamelHashMap">
        select
            u.*,
            i.name,
            i.category,
            i.type
        from (select * from data_use where DEL_ID is null) as u
        left join data_item as i
        on u.data_id = i.id
        <where>
            <if test="name != null and name != ''">
                and i.name like concat('%', #{name}, '%')
            </if>
            <if test="regId != null">
                and u.REG_ID = #{regId}
            </if>
        </where>
        <include refid = "sort"/>
        <include refid = "paging"/>
    </select>
</mapper>