# 참고용 .env 파일
# 빌드환경에 따라 아래 내용을 복사,기입하여 .env 파일을 만들어준다.
# development -> .env.development
# production -> .env.production

# common
APP_NAME = datacollector-beach-sun-rise-set
APP_VERSION = '0.1.0'
NODE_ENV = development
WORKDIR = /home/beach-sun-rise-set
LOGDIR = logs
SERVICE_PORT = 4000

CRON_INITIAL_PATTERN = '*/10 * * * * *'

AVRO_SCHEMA_FILE__MEASURE_POSITION = MeasurePosition.avsc
AVRO_SCHEMA_FILE__BEACH_SUN_RISE_SET = BeachSunRiseSet.avsc

DATAINTERFACE_IPADDRESS__UPSERT = 'http://tw-data-interface:8084/v1/avro'
DATAINTERFACE_IPADDRESS__FIND = 'http://tw-data-interface:8084/v1/avro/find'
OTELCOLLECTOR_IPADDRESS = 'http://tw-opentelemetry-collector:4317'
OPENAPI_URL = 'http://apis.data.go.kr/1360000/BeachInfoservice/getSunInfoBeach'


# secret
# OPENAPIKEY_DATAGOKR = #입력할것