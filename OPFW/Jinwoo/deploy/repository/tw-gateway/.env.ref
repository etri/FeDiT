# .env.ref -> .env 복사후 필수 정보 기입
NODE_ENV = production

# tw-gateway
TW_GATEWAY__APP_NAME = tw-gateway
TW_GATEWAY__APP_VERSION = '0.1.0'
TW_GATEWAY__WORK_DIR = /home/tw-gateway
TW_GATEWAY__CONTAINER_SERVICE_PORT = 8080
TW_GATEWAY__HOST_PORT = 8083

# tw-service-manager
TW_SERVICE_MANAGER__APP_NAME = tw-service-manager
TW_SERVICE_MANAGER__APP_VERSION = '0.1.0'
TW_SERVICE_MANAGER__WORK_DIR = /home/tw-service-manager
TW_SERVICE_MANAGER__CONTAINER_SERVICE_PORT = 8080
