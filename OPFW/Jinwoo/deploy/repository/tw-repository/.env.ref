# .env.ref -> .env 복사후 필수 정보 기입
NODE_ENV = production

# DB
MARIADB_WORK_DIR = /home/mysql
MARIADB_PORT = 33063
MARIADB_IP_ADDRESS = host.docker.internal
MARIADB_USER = jin
#MARIADB_PASSWORD = 필수
#MARIADB_ROOT_PASSWORD = 필수
MARIADB_DATABASE = repository

# TW_REPOSITORY
TW_REPOSITORY__APP_NAME = tw-repository
TW_REPOSITORY__HOST_SERVICE_PORT = 8680