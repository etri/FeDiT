# 참고용 .env 파일
# 빌드환경에 따라 아래 내용을 복사,기입하여 .env 파일을 만들어준다.
# development -> .env.development
# production -> .env.production

# common
APP_NAME = tw-traffic-rest
APP_VERSION = '0.1.0'
NODE_ENV = production
WORKDIR = /home/tw-traffic-rest
LOGDIR = logs
SERVICE_PORT = 8202

CORS_ORIGIN = '*'

DATAINTERFACE_IPADDRESS = 'http://tw-traffic-data-interface-mango:8080/v1/data-interface'

DATABASESOURCE__HOST = 'tw-traffic-db-poc1-mariadb'
DATABASESOURCE__PORT = 3306
DATABASESOURCE__USER = 'root'
DATABASESOURCE__PASSWORD = 'jin1234'
DATABASESOURCE__DATABASE = 'poc1'