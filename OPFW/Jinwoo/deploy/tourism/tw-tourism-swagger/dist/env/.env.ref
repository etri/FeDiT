# 참고용 .env 파일
# 빌드환경에 따라 아래 내용을 복사,기입하여 .env 파일을 만들어준다.
# development -> .env.development
# production -> .env.production

# common
APP_NAME = tw-tourism-swagger
APP_VERSION = '0.1.0'
NODE_ENV = production
WORKDIR = /home/tw-tourism-swagger
LOGDIR = logs
CONTAINER_SERVICE_PORT = 8080
HOST_SERVICE_PORT = 8303
