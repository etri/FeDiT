	/* 스케줄잡 배치 실행부
	 * @see kr.reb.data.job.abst.RebJobAbstractClass#execute(kr.reb.data.dto.JobMstDTO)
	 */
	@Override
	public void execute(JobMstDTO jobInfo) {
		init();
		long jobStartTime=0;
		long jobEndTime=0;
		long processStartTime=0;
		long processEndTime=0;
		int processStep=0;
		JobRunHstDTO jobRunHstDTO=null;
		Timestamp timeStmp=null;
		String csvFilePath =null;
		String rdfFilePath=null;
		boolean isEnterMoveFileStep=false;
		List<ProcessMstDTO> processList = new ArrayList<ProcessMstDTO>();
		
		try {
			jobStartTime=System.currentTimeMillis();
			
			logTitle = "["+jobInfo.getJobNmKr()+"]";
			
			LOGGER.info(logTitle+"스케줄 프로세스가 시작됩니다.");
			LOGGER.info(logTitle+"실행 프로세스 정보 및 연계설정정보를 읽어옵니다."); 
			
			processList = mapper.getProcessMstWithSnByJobId(jobInfo);
			JobLinkConfigDTO jobConfig = mapper.getOneJobLinkConfig(jobInfo);
			
			LOGGER.info(logTitle+"실행 프로세스 총 ["+processList.size()+"단계]");
			
			for(ProcessMstDTO processInfo : processList) {
				int logSn=processList.indexOf(processInfo)+1;
				LOGGER.info(logTitle+"실행 프로세스 정보("+logSn+"단계) : "+processInfo.toString());
			}
			
			LOGGER.info(logTitle+"잡 설정정보 : "+jobConfig.toString());
			
			
			//프로세스 호출전 job 실행이력 생성(처리상태 N, 시작시간만 등록)
			jobRunHstDTO  = super.processStart(jobInfo,jobStartTime);
			
		//프로세스  시작
			processStep=1;
			super.loggingProcessStart(logTitle, processStep, processList, LOGGER);
		//프로세스 1 api 호출후 DB저장 (API 두개)
			processStartTime=System.currentTimeMillis();
			//관리자화면에서 잡유형을 UPLOAD_WEB으로 바꿨다면 원천데이터를 수동으로 업로드했다고 가정하기때문에 이 절차는 생략된다.
			if(jobConfig.getJobType().equals("OPENAPI")) {
			//API 1 아파트 분양 상세정보 호출
				JSONArray apiResultData = callGetApiForJob003(jobConfig,"getAPTLttotPblancDetail",true);
				String[] _headers = mapper.selectTbColNms("SRCDATA_APPLYHOME_APT_INFO");
				if(apiResultData.length()>0)saveDatabaseByApiResut(apiResultData,_headers,"SRCDATA_APPLYHOME_APT_INFO");
				
		    //API 2 아파트 분양 주택형별 상세정보 호출
				apiResultData = callGetApiForJob003(jobConfig,"getAPTLttotPblancMdl",true);
				_headers = mapper.selectTbColNms("SRCDATA_APPLYHOME_APT_TYPE_INFO");
				if(apiResultData.length()>0)saveDatabaseByApiResut(apiResultData,_headers,"SRCDATA_APPLYHOME_APT_TYPE_INFO");
			}
			processEndTime=System.currentTimeMillis();
			processStep = super.nextStep(processStep,jobRunHstDTO,processList,LOGGER,processStartTime,processEndTime);
		//프로세스 1 끝
			
		//프로세스 2 재료데이터 가공
			processStartTime=System.currentTimeMillis();
			AptLottDtldInfoDTO aptSubDivDTO = new AptLottDtldInfoDTO();
			mapper.insertDatasetAptSubdivsDtldInfo(aptSubDivDTO);
			timeStmp = aptSubDivDTO.getUpdtTimeStmp();
			mapper.updateAptSubdivsDtldInfoLoanAbleAmount(timeStmp);
				
			processEndTime=System.currentTimeMillis();
			processStep = super.nextStep(processStep,jobRunHstDTO,processList,LOGGER,processStartTime,processEndTime);
		//프로세스 2 끝
			
			
		//프로세스3 송신파일(CSV,RDF) 생성
			processStartTime=System.currentTimeMillis();
			
			//csv 데이터 가져오기, rdf 메타 태그내용 가져오기
			List<HashMap<String,Object>> resultDataset = mapper.selectAptSubdivsDtldInfoByTimeStmp(aptSubDivDTO);
			
			RdfMetaCommonDTO metaCommonDto = mapper.getRdfMetaCommon();
			RdfMetaDatasetDTO metaDatasetDto = mapper.getRdfMetaDataset(jobInfo);

			//csv 가공 
			String dataCode = metaDatasetDto.getDctIdentifier();
			int resultCount = resultDataset.size();
			String[] headers = mapper.selectTbColNms(jobInfo.getSaveTbNm());
			csvFilePath = fileUtil.writeCSV(jobConfig.getSendFileSaveDir(),dataCode, resultDataset, UdtCommonConstant.FILE_ENC_UTF8, headers,true);
			if(csvFilePath==null)throw new IOException("CSV 생성에 실패하였습니다.["+jobConfig.getSendFileSaveDir()+"/"+dataCode+".csv]");

			//rdf가공
//			String startDate = RebCommonUtil.getMondayDateStringOfWeek()+"000000";
//			String endDate = RebCommonUtil.getFridayDateStringOfWeek()+"235959";
			//2022 05 13 rdf startDate, endDate 변경 
			/*주,월단위 데이터는 예를들어 2022 05 13일에 보내는 파일이라면 
			startDate와 endDate를 2022-05-13으로 통일하여 보내고
			반기데이터는 보내는 날과 상관없이 데이터의 시작잘짜 (예를들어 2022-01-01 or 2022-07-01)로 
			startDate와 endDate를 통일하여 보냄*/
			String startDate = UdtCommonUtil.getTodayDateString();
			rdfFilePath = fileUtil.makeRdfFile(metaCommonDto,metaDatasetDto,UdtCommonConstant.FILE_ENC_UTF8
					,jobConfig.getSendFileSaveDir(), dataCode,startDate,startDate);
			if(rdfFilePath==null)throw new IOException("RDF 생성에 실패하였습니다.["+jobConfig.getSendFileSaveDir()+"/"+dataCode+".rdf]");
			
			processEndTime=System.currentTimeMillis();
			processStep = super.nextStep(processStep,jobRunHstDTO,processList,LOGGER,processStartTime,processEndTime);
		//프로세스3 끝
			
		//프로세스4 송신파일 중계서버 파일전송
			processStartTime=System.currentTimeMillis();
			
			//sftp업로드vo 세팅 [!업로드경로 : {reb.sftp.upload.homedir(프로퍼티)}/DATASET/데이터셋명(테이블명)/ : 중계서버의 업로드 경로는 다음스텝에서 교빅SFTP API호출에서 사용하기 때문에 사용자가 웹화면에서 관리하면 노답됌]
			String uploadDir = "DATASET/"+jobInfo.getSaveTbNm()+"/";

			//sftp 업로드 호출
			FtpServiceVO csvUploadVo = super.settingUploadSftpServiceVO(uploadDir, csvFilePath);
			FtpServiceVO rdfUploadVo = super.settingUploadSftpServiceVO(uploadDir, rdfFilePath);
			String csvUploadFilePath = ftpUtil.uploadUsingSFTP(csvUploadVo, logTitle);
			String rdfUploadFilePath = ftpUtil.uploadUsingSFTP(rdfUploadVo, logTitle);
			processEndTime=System.currentTimeMillis();
			processStep = super.nextStep(processStep,jobRunHstDTO,processList,LOGGER,processStartTime,processEndTime);
		//프로세스4 끝
			
			//if(true)throw new NullPointerException("에러테스트열");
			
		//프로세스5 중계서버로 교통빅데이터 플랫폼 업로드 API 호출
			/*
			processStartTime=System.currentTimeMillis();
			Map<String,Object> apiParams = new HashMap<String,Object>();
			apiParams.put("dataCode", metaDatasetDto.getDctIdentifier());
			apiParams.put("dataSetKrNm", jobInfo.getJobNmKr());
			apiParams.put("csvLocalFilePath", csvUploadFilePath);
			apiParams.put("rdfLocalFilePath", rdfUploadFilePath);
			String jsonString = restApiUtil.callPostApi(middleSvrApiEndpoint, apiParams, null, logTitle);
			JSONObject result = restApiUtil.parsingJsonObjects(jsonString);
			String resultCode = (String)result.get("resultStatusCode");
			if(!resultCode.equals("200")) {
				if(result.get("errorContent")!=null)LOGGER.error((String)result.get("errorContent"));
				throw new IOException("부동산원 중계서버 -> 교통빅데이터플랫폼 파일업로드 API호출에 실패하였습니다. 로그를 확인해주세요");
			}
			LOGGER.info(logTitle+"api 호출에 성공하였습니다. 호출결과 : "+jsonString+"");
			
			JSONObject resultMap = (JSONObject)result.get("resultMap");
			jobRunHstDTO.setDoroCsvfileFullPath((String)resultMap.get("saveCsvFullPath"));;
			jobRunHstDTO.setDoroRdffileFullPath((String)resultMap.get("saveRdfFullPath"));;
			
			processEndTime=System.currentTimeMillis();
			processStep = super.nextStep(processStep,jobRunHstDTO,processList,LOGGER,processStartTime,processEndTime);
			*/
		//프로세스5 끝
			
			
		//프로세스6 송신파일 디렉토리이동(파일DB)저장
			processStartTime=System.currentTimeMillis();
			BigDecimal saveFileId=super.moveFileAndSaveDataBase(csvFilePath, rdfFilePath, true);
			isEnterMoveFileStep=true;
			processEndTime=System.currentTimeMillis();
			processStep = super.nextStep(processStep,jobRunHstDTO,processList,LOGGER,processStartTime,processEndTime);
		//프로세스6 끝
		
		//잡 종료(이력 종료처리+이력에 fileId넣기)
			jobEndTime=System.currentTimeMillis();
			jobRunHstDTO.setJobEndAt("Y");
			jobRunHstDTO.setProcessSn(null);
			jobRunHstDTO.setJobEndDt(UdtCommonUtil.getStringTimeByFormatter(UdtCommonConstant.DB_DATESTRING_FORMAAT,jobEndTime));
			jobRunHstDTO.setJobElapTime(new BigDecimal(jobEndTime-jobStartTime));
			jobRunHstDTO.setSendFileId(saveFileId);
			jobRunHstDTO.setSendWriteLine(new BigDecimal(resultCount));
			jobRunHstDTO.setJobEndRslt("S");
			super.processEnd(jobRunHstDTO);
			
			LOGGER.info(logTitle+"스케줄 프로세스가 종료되었습니다. 총 소요시간 :["+TimeUnit.MILLISECONDS.toSeconds(jobEndTime-jobStartTime)+"초]");
		
		}catch(Exception e) {
			//에러처리
			try {
				//데이터셋 db insert됐을경우 삭제  
				if(timeStmp!=null) {
					mapper.deleteAptSubdivsDtldInfoByTimeStmp(timeStmp);
				}

				//CSV,RDF파일 만들기까진 되었는데 교빅업로드순서까지 에러가 있는경우
				if(!isEnterMoveFileStep&&csvFilePath!=null&&rdfFilePath!=null) {
					BigDecimal saveFileId=super.moveFileAndSaveDataBase(csvFilePath, rdfFilePath, false);
					jobRunHstDTO.setSendFileId(saveFileId);
				}
				
				//CSV는 있고 RDF만들다가 에러난경우 CSV 파일만 실패디렉토리로이동(CSV가먼저 만들어져서 반대경우는 있을수없음)
				if(!isEnterMoveFileStep&&csvFilePath!=null&&rdfFilePath==null) {
					String addFolder ="/FAILED/";
					addFolder+=fileUtil.genYYYYMMDDDirectory();
					String orgCsvFileNm=fileUtil.getOnlyFileNm(csvFilePath);
					String saveCsvFileNm=fileUtil.genMilitimeSaveFileName(orgCsvFileNm);
					String saveCsvFilePath=fileUtil.getOnlyPath(csvFilePath);
					saveCsvFilePath+=addFolder;
					fileUtil.moveFile(saveCsvFileNm, csvFilePath, saveCsvFilePath);
				}
				

			}catch(Exception e1) {
				LOGGER.error(logTitle+"에러 처리중 오류가 발생하였습니다 로그를 확인해주세요.");
				e1.printStackTrace();
			}finally {
				super.rebJobExceptionHandle(logTitle, processStep, processList, LOGGER, e, jobRunHstDTO,jobStartTime,processStartTime);
			}
			
		}
	}
	
	
	
	/**
	 * @설명 : Job003 - REST API 호출
	 * @생성일 : 2022. 02. 23.
	 * @파라미터 : JobLinkConfigDTO - 잡 연계설정정보, String - api 앤드포인트 메서드명(애는 호출하는 api2개라 구분해야함),boolean - 재귀호출(페이징)용 토탈카운트 변수 초기화여부
	 * @리턴 : JSONArray - api 결과 jsonarray
	 * @비고 : API 호출시 전체가져오기에 대한 기능 및 API목록이 없음, 때문에 페이징 변수를 활용하여 API TOTAL건수에 만족할때까지 재귀호출
	 */
	private JSONArray callGetApiForJob003(JobLinkConfigDTO jobConfig, String apiMethodNm, boolean totalCountResetAt) throws Exception {
		
		if(totalCountResetAt) {
			this.apiTotalCount=0;
			this.totalResultArray= new JSONArray();
			this.apiPage=1;
		}
		
		String jsonStr = apiUtil.callGetApi(jobConfig.getUdtApiEndPoint()+apiMethodNm, makeApiParameters(apiPage,apiPagePer,jobConfig.getUdtApiParam()), null, logTitle);
		
		//System.out.println(jsonStr);
		
		JSONObject jsonObj = apiUtil.parsingJsonObjects(jsonStr);
		
		int totalCount = jsonObj.getInt("totalCount");
		
		JSONArray jsonArray = jsonObj.getJSONArray("data");
		
		
		for(int i=0; i<jsonArray.length();i++) {
			JSONObject obj = jsonArray.getJSONObject(i);
			totalResultArray.put(obj);
		}
		
		apiTotalCount = apiTotalCount + jsonArray.length();
		
		//API페이징 전체가져오기(재귀호출)
		if(apiTotalCount<totalCount) {
			Thread.sleep(1000);
			this.apiPage = apiPage+1;
			callGetApiForJob003(jobConfig,apiMethodNm,false);
		}
		
		return totalResultArray;
		
	}
	
	/**
	 * @설명 : 한국부동산원_전국 청약 분양정보 상세조회 서비스 API 파라미터 세팅
	 * @생성일 : 2022. 02. 23.
	 * @파라미터 : int - 페이지쪽수, int - 페이지당 로우수
	 * @리턴 : Map<String,Object>
	 * @비고 : APIKEY - 프로퍼티 (공공데이터포털에서 2년주기 재발급받아야야함) 
	 */
	private Map<String,Object> makeApiParameters(int page, int pagePer, String apikey){
		Map<String,Object> getParam = new HashMap<String,Object>();
		getParam.put("page", page);
		getParam.put("perPage", pagePer);
		getParam.put("serviceKey", apikey);
		return getParam;
	}
	
	/**
	 * @설명 : API호출결과를 DB에 저장(벌크인서트)
	 * @생성일 : 2022. 2. 23.
	 * @파라미터 : JSONArray-결과 데이터셋(알맹이만), String[] - 컬럼배열, String - 테이블명
	 * @리턴 : void
	 * @비고 : 
	 */
	private void saveDatabaseByApiResut(JSONArray apiResultData,String[] _headers,String tbNm) throws Exception{
		List<Map<String,Object>> qureyPramList = new ArrayList<Map<String,Object>>();
		
		//원천데이터 테이블 백업 및 트렁케이트
		mapper.bulkInsertBackupSrcDataTable(tbNm);
		mapper.truncateTable(tbNm);
		
		//원천데이터 파라미터 리스트 셋팅
		Map<String,Object> qureyPramMap;			
		for(int i=0; i<apiResultData.length(); i++) {
			qureyPramMap = new HashMap<String,Object>();
			JSONObject obj = (JSONObject)apiResultData.get(i);
			for(String columns: _headers) {
				Object value;
				if(obj.isNull(columns.toUpperCase()))value="";
				else value = obj.get(columns.toUpperCase());
				
				qureyPramMap.put(columns.toUpperCase(), value);
			}
			qureyPramList.add(qureyPramMap);
		}
		
		//벌크인서트
		int insertCount=0;
		if(qureyPramList.size()>bulkInsertLimit) { //벌크처리
			//(포스트그래스 파라미터 최대 32767개만 가능, 컬럼이 40개고 400줄드가면 파라미터 16000개임, 근데 컬럼41개짜리있음ㅋ)
			int currCount=0;
			int mok = qureyPramList.size()/bulkInsertLimit;
			int nam = qureyPramList.size()%bulkInsertLimit;
			if(nam>0)mok=mok+1;
			
			for(int i=0; i<mok; i++) {
				
				int endListIndex=0;
				if(i==mok-1) {
					endListIndex=bulkInsertLimit*(i)+nam;
				}
				else {
					endListIndex=bulkInsertLimit*(i+1);
				}
				
				List<Map<String,Object>> subDataList=new ArrayList<Map<String,Object>>(qureyPramList.subList(currCount, endListIndex));
				 
				if(tbNm.equals("SRCDATA_APPLYHOME_APT_INFO")) {
					ThreadContext.put("log", "N");
					insertCount = insertCount+mapper.bulkInsertSrcdataApplyhomeAptInfo(subDataList);;//원본 insert
					ThreadContext.remove("log");
				}else if(tbNm.equals("SRCDATA_APPLYHOME_APT_TYPE_INFO")) {
					ThreadContext.put("log", "N");
					insertCount = insertCount+mapper.bulkInsertSrcdataApplyhomeAptTypeInfo(subDataList);;//원본 insert
					ThreadContext.remove("log");
					
				}else {
					throw new NullPointerException("테이블명이 잘못되었습니다.");
				}
		
				currCount=currCount+bulkInsertLimit;
				try{Thread.sleep(50);}catch(InterruptedException e) {e.printStackTrace();}
				
			}
		}else {
			if(tbNm.equals("SRCDATA_APPLYHOME_APT_INFO")) {
				ThreadContext.put("log", "N");
				insertCount = mapper.bulkInsertSrcdataApplyhomeAptInfo(qureyPramList);//원본 insert
				ThreadContext.remove("log");
			}else if(tbNm.equals("SRCDATA_APPLYHOME_APT_TYPE_INFO")) {
				ThreadContext.put("log", "N");
				insertCount = mapper.bulkInsertSrcdataApplyhomeAptTypeInfo(qureyPramList);//원본 insert
				ThreadContext.remove("log");
			}else {
				throw new NullPointerException("테이블명이 잘못되었습니다.");
			}
		}
	}

}
