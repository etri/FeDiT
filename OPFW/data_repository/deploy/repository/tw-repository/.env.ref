# .env.ref -> .env 복사후 필수 정보 기입
NODE_ENV = production

# DB
MARIADB_WORK_DIR = /home/mysql
MARIADB_PORT = 33063
MARIADB_IP_ADDRESS = host.docker.internal
MARIADB_USER = jin
#MARIADB_PASSWORD = 필수
#MARIADB_ROOT_PASSWORD = 필수
MARIADB_DATABASE = repository

# TW_REPOSITORY
TW_REPOSITORY__APP_NAME = tw-repository
TW_REPOSITORY__JDBC_URL = jdbc:mariadb://tw-repository-db-mariadb:3306/repository
#TW_REPOSITORY__JDBC_USERNAME = 필수
#TW_REPOSITORY__JDBC_PASSWORD = 필수
TW_REPOSITORY__HOST_SERVICE_PORT = 8680 # localhost:xxxx 로 접근할 포트


TW_REPOSITORY__FILE_DIR = /jw/files/
TW_REPOSITORY__GATEWAY_URL = http://tw-gateway:8083
TW_REPOSITORY__PROMETHEUS_API_URL =


# 드림시큐리티 본인확인 설정
# 해당 서비스 이용하면 설정해준다.
TW_REPOSITORY__AUTH_MOK_ENABLED = false
# dev -> https://scert.mobile-ok.com/gui/service/v1/result/request
TW_REPOSITORY__AUTH_MOK_URL = https://scert.mobile-ok.com/gui/service/v1/result/request
TW_REPOSITORY__AUTH_MOK_PATH = 
#TW_REPOSITORY__AUTH_MOK_CLIENT_ID = 
#TW_REPOSITORY__AUTH_MOK_PWD = 

