# 참고용 .env 파일
# 빌드환경에 따라 아래 내용을 복사,기입하여 .env 파일을 만들어준다.
# development -> .env.development
# production -> .env.production

# common
APP_NAME = tw-traffic-datacollector-road-operation-status
APP_VERSION = '0.1.0'
NODE_ENV = production
WORKDIR = /home/datacollector-road-operation-status
LOGDIR = logs
SERVICE_PORT = 8213

CRON_INITIAL_PATTERN = '15 0/10 * * * *'
# CRON_INITIAL_PATTERN = '*/10 * * * * *'

AVRO_SCHEMA_FILE__ROAD_OPERATION_STATUS = RoadOperationStatus.avsc

DATAINTERFACE_IPADDRESS__UPSERT = 'http://tw-data-interface:8080/v1/avro'
DATAINTERFACE_IPADDRESS__FIND = 'http://tw-data-interface:8080/v1/avro/find'
OTELCOLLECTOR_IPADDRESS = 'http://tw-opentelemetry-collector:4317'

OPENAPI_URL__DANGER = 'http://api.jejuits.go.kr/api/infoRoadEventList'
OPENAPI_URL__CONTROL = 'http://api.jejuits.go.kr/api/infoRoadCloseList'
OPENAPI_URL__WORK = 'http://api.jejuits.go.kr/api/infoRoadWorkList'

# secret
OPENAPIKEY_JEJUCITS = #입력할것