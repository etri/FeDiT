    "@opentelemetry/resources": "^1.22.0",
    "@opentelemetry/sdk-metrics": "^1.22.0",
    "@opentelemetry/semantic-conventions": "^1.22.0",
    "avsc": "^5.7.7",
    "axios": "^1.6.7",
    "cron": "^3.1.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "reflect-metadata": "^0.2.1",
    "typedi": "^0.10.0",
    "winston": "^3.12.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
