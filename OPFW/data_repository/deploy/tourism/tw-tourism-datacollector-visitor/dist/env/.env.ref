# 참고용 .env 파일
# 빌드환경에 따라 아래 내용을 복사,기입하여 .env 파일을 만들어준다.
# development -> .env.development
# production -> .env.production

# common
APP_NAME = tw-tourism-datacollector-visitor
APP_VERSION = '0.1.0'
NODE_ENV = production
WORKDIR = /home/visitor
LOGDIR = logs
SERVICE_PORT = 8310

CRON_INITIAL_PATTERN = '30 0 */1 * * *'
#CRON_INITIAL_PATTERN = '0 */1 * * * *'

AVRO_SCHEMA_FILE__MEASURE_POSITION = MeasurePosition.avsc
AVRO_SCHEMA_FILE__VISITOR = Visitor.avsc
AVRO_SCHEMA_FILE__VISITJEJU = Visitjeju.avsc

DATAINTERFACE_IPADDRESS__UPSERT = 'http://tw-data-interface:8080/v1/avro'
DATAINTERFACE_IPADDRESS__FIND = 'http://tw-data-interface:8080/v1/avro/find'
OTELCOLLECTOR_IPADDRESS = tw-opentelemetry-collector:4317

URL_BASE__PLACE_MAP_KAKAO = 'https://place.map.kakao.com/'


# secret
# 없음