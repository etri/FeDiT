<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper   PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="net.jw.twin.repository.db.institution.mapper.InstitutionMapper">

	<!--	 common 	-->
    <sql id="sort">
      <if test="null != sort and null != sortOrd"> order by ${sort} ${sortOrd}, id ${sortOrd} </if>
    </sql>

    <sql id="paging">
      <if test="null != pagingYn and pagingYn == true" >
        limit #{start}, #{length}
      </if>
    </sql>

	<!--	 selectList 	-->
	<select id="selectList" parameterType="institutionSearch" resultType="institution">
		select
			*
		from
			institution
		<!--<where>-->
			<!--<if test="null != id" >                       and id = #{id}                                     </if>-->
			<!--<if test="null != name" >                     and name = #{name}                                 </if>-->
			<!--<if test="null != managerUserId" >            and manager_user_id = #{managerUserId}             </if>-->
			<!--<if test="null != address" >                  and address = #{address}                           </if>-->
			<!--<if test="null != addressDetail" >            and address_detail = #{addressDetail}              </if>-->
			<!--<if test="null != zipCode" >                  and zip_code = #{zipCode}                          </if>-->
			<!--<if test="null != phoneNumber" >              and phone_number = #{phoneNumber}                  </if>-->
			<!--<if test="null != regId" >                    and REG_ID = #{regId}                              </if>-->
			<!--<if test="null != regDt" >                    and REG_DT = #{regDt}                              </if>-->
			<!--<if test="null != delId" >                    and DEL_ID = #{delId}                              </if>-->
			<!--<if test="null != delDt" >                    and DEL_DT = #{delDt}                              </if>-->
		<!--</where>-->
		<where>
			DEL_DT IS NULL
			<if test="null != id" >                           and id = #{id}                                    </if>
			<if test="null != name" >                         and name like CONCAT('%', #{name}, '%')           </if>
			<if test="null != managerUserId" >                and manager_user_id = #{managerUserId}            </if>
			<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
			<if test="null != startRegDt" >                   and REG_DT <![CDATA[ >= ]]> #{startRegDt}         </if>
			<if test="null != endRegDt" >                     and REG_DT <![CDATA[ < ]]> #{endRegDt}            </if>
		</where>
		<!--		where	-->
		<!--		DEL_ID IS NULL	-->
		<include refid = "sort"/>
		<include refid = "paging"/>
	</select>

	<!--	 selectListNullCheck 	-->
	<select id="selectListNullCheck" parameterType="institutionSearch" resultType="institution">
		select
			*
		from
			institution
		where
			DEL_DT IS NULL
			<foreach collection="isNotNull" item="value"
					open="and (" separator="and " close=")">
				${value} is not null
			</foreach>
			<foreach collection="isNull" item="value"
					open="and (" separator="and " close=")">
				${value} is null
			</foreach>
			<if test="null != id" >                           and id = #{id}                                    </if>
			<if test="null != name" >                         and name like CONCAT('%', #{name}, '%')           </if>
			<if test="null != managerUserId" >                and manager_user_id = #{managerUserId}            </if>
			<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
			<if test="null != startRegDt" >                   and REG_DT <![CDATA[ >= ]]> #{startRegDt}         </if>
			<if test="null != endRegDt" >                     and REG_DT <![CDATA[ < ]]> #{endRegDt}            </if>
		<!--		where	-->
		<!--		DEL_ID IS NULL	-->
		<include refid = "sort"/>
		<include refid = "paging"/>
	</select>

	<!--	 select 	-->
	<select id="select" parameterType="institutionSearch" resultType="institution">
		select
			*
		from
			institution
		<where>
			DEL_DT IS NULL
			<if test="null != id" >                           and id = #{id}                                    </if>
			<if test="null != name" >                         and name like CONCAT('%', #{name}, '%')           </if>
			<if test="null != managerUserId" >                and manager_user_id = #{managerUserId}            </if>
			<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
			<if test="null != startRegDt" >                   and REG_DT <![CDATA[ >= ]]> #{startRegDt}         </if>
			<if test="null != endRegDt" >                     and REG_DT <![CDATA[ < ]]> #{endRegDt}            </if>
		</where>
	</select>

	<!--	 selectBy 	-->

	<!--	 count 	-->
	<select id="count" parameterType="institutionSearch" resultType="java.lang.Integer">
		select
			COUNT( * )
		from (
				select 1 from institution
				<where>
					DEL_DT IS NULL
					<if test="null != id" >                           and id = #{id}                                    </if>
					<if test="null != name" >                         and name like CONCAT('%', #{name}, '%')           </if>
					<if test="null != managerUserId" >                and manager_user_id = #{managerUserId}            </if>
					<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
					<if test="null != startRegDt" >                   and REG_DT <![CDATA[ >= ]]> #{startRegDt}         </if>
					<if test="null != endRegDt" >                     and REG_DT <![CDATA[ < ]]> #{endRegDt}            </if>
				</where>
				<include refid = "sort"/>
				<include refid = "paging"/>
		) t
	</select>

	<!--	 countNullCheck 	-->
	<select id="countNullCheck" parameterType="institutionSearch" resultType="java.lang.Integer">
		select
			COUNT( * )
		from (
				select 1 from institution
				where
					DEL_DT IS NULL
					<foreach collection="isNotNull" item="value"
							open="and (" separator="and " close=")">
						${value} is not null
					</foreach>
					<foreach collection="isNull" item="value"
							open="and (" separator="and " close=")">
						${value} is null
					</foreach>
					<if test="null != id" >                           and id = #{id}                                    </if>
					<if test="null != name" >                         and name like CONCAT('%', #{name}, '%')           </if>
					<if test="null != managerUserId" >                and manager_user_id = #{managerUserId}            </if>
					<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
					<if test="null != startRegDt" >                   and REG_DT <![CDATA[ >= ]]> #{startRegDt}         </if>
					<if test="null != endRegDt" >                     and REG_DT <![CDATA[ < ]]> #{endRegDt}            </if>
				<include refid = "sort"/>
				<include refid = "paging"/>
		) t
	</select>

	<!--	 insert 	-->
	<insert id="insert" parameterType="institution" useGeneratedKeys="true" keyProperty="id">
		insert institution
		<set>
			REG_ID = #{regId},
			REG_DT = SYSDATE(),
			<if test="null != id" >                      id = #{id},                                   </if>
			<if test="null != name" >                    name = #{name},                               </if>
			<if test="null != managerUserId" >           manager_user_id = #{managerUserId},           </if>
			<if test="null != address" >                 address = #{address},                         </if>
			<if test="null != addressDetail" >           address_detail = #{addressDetail},            </if>
			<if test="null != zipCode" >                 zip_code = #{zipCode},                        </if>
			<if test="null != phoneNumber" >             phone_number = #{phoneNumber},                </if>
		</set>
	</insert>

	<!--	 update 	-->
	<update id="update" parameterType="institution">
		update institution
		<set>
			<if test="null != name" >                    name = #{name},                              </if>
			<if test="null != managerUserId" >           manager_user_id = #{managerUserId},          </if>
			<if test="null != address" >                 address = #{address},                        </if>
			<if test="null != addressDetail" >           address_detail = #{addressDetail},           </if>
			<if test="null != zipCode" >                 zip_code = #{zipCode},                       </if>
			<if test="null != phoneNumber" >             phone_number = #{phoneNumber},               </if>
			<if test="null != regDt" >                   REG_DT = #{regDt},                           </if>
		</set>
		<where>
			<if test="null != id" >                           and id = #{id}                                    </if>
		</where>
	</update>

	<!--	 delete 	-->
	<update id="delete" parameterType="institution">
		delete from institution
		<where>
			<if test="null != id" >                           and id = #{id}                                    </if>
			<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
		</where>
	</update>

	<!--	 deleteSoft 	-->
	<update id="deleteSoft" parameterType="institution">
		update institution set 
			DEL_ID = #{delId},
			DEL_DT = SYSDATE()
		<where>
			<if test="null != id" >                           and id = #{id}                                    </if>
			<if test="null != regId" >                        and REG_ID = #{regId}                             </if>
		</where>
	</update>

	<!--	 etc 	-->
	<insert id="insertList" parameterType="institution">
		insert into institution
		(
			id,
			name,
			manager_user_id,
			address,
			address_detail,
			zip_code,
			phone_number,
			REG_ID,
			REG_DT,
			DEL_ID,
			DEL_DT)
		values
		<foreach collection="list" item="item" separator=",">
		(
			#{item.id},
			#{item.name},
			#{item.managerUserId},
			#{item.address},
			#{item.addressDetail},
			#{item.zipCode},
			#{item.phoneNumber},
			#{item.regId},
			#{item.regDt},
			#{item.delId},
			#{item.delDt})
		</foreach>
		on duplicate key update
			id=values(id),
			name=values(name),
			manager_user_id=values(manager_user_id),
			address=values(address),
			address_detail=values(address_detail),
			zip_code=values(zip_code),
			phone_number=values(phone_number),
			REG_ID=values(REG_ID),
			REG_DT=values(REG_DT),
			DEL_ID=values(DEL_ID),
			DEL_DT=values(DEL_DT)
	</insert>
</mapper>