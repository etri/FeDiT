# =============================================================================
#  이미지 묶음 제작 설정 (사내 전용)
#  cp bundle.env.example bundle.env  후 값을 채운다.
#  설치용 ../.env 와는 별개다. 이 파일은 설치 서버에 가져가지 않는다.
# =============================================================================

# 레지스트리 계정은 이 파일에 두지 않는다.
# fetch-from-registry.sh 를 실행할 때 아이디/비밀번호를 직접 입력한다.

# --- Jib(gradle) 빌드용 JDK ---------------------------------------------------
# NDXPro 코어는 gradle 7.4~7.5.1 을 쓰는데 Java 21 에서는 빌드가 깨진다.
# 비워 두면 /usr/libexec/java_home -v 17 로 자동 탐색한다 (맥).
JAVA_HOME_FOR_BUILD=

# --- 빌드 대상 플랫폼 --------------------------------------------------------
# 설치 서버가 리눅스 x86_64 면 이 값을 그대로 둔다.
TARGET_PLATFORM=linux/amd64

# =============================================================================
#  소스코드에서 빌드할 때 (build-from-source.sh)
#
#  SRC_* : 소스 디렉터리. 이 파일이 있는 곳(image-bundle/) 기준 상대경로.
#  OPT_* : docker build 에 붙일 추가 인자 (모노레포의 --target 등). 없으면 생략.
#
#  빌드 방식은 자동으로 판별한다.
#    Dockerfile 있음  → docker build --platform
#    gradlew + jib    → ./gradlew jibDockerBuild (Jib 플러그인)
# =============================================================================

# --- 연합트윈 화면 / BFF ------------------------------------------------------
# 하나의 모노레포에서 --target 으로 나눠 빌드한다 (Jenkinsfile 과 동일)
SRC_UNION_TWIN_FE=../../source/union-twin-fe
OPT_UNION_TWIN_FE="--target union-twin-fe --build-arg PKG=@workspace/union-twin-client"

SRC_UNION_TWIN_BE=../../source/union-twin-fe
OPT_UNION_TWIN_BE="--target union-twin-be --build-arg PKG=@workspace/union-twin-be"

# --- FDT 뷰어 -----------------------------------------------------------------
SRC_FDT_SERVICE=../../source/fdt-service

# --- NDXPro 코어 (전부 Jib) ----------------------------------------------------
SRC_NDXPRO_EUREKASERVER=../../source/eurekaServer
SRC_NDXPRO_GATEWAYSERVER=../../source/gatewayServer
SRC_NDXPRO_DATAINGEST=../../source/dataIngest
SRC_NDXPRO_TRANSLATORBUILDER=../../source/translatorBuilder
SRC_NDXPRO_NGSI_TRANSLATOR=../../source/ngsiTranslator
SRC_NDXPRO_CORE_DATABROKER=../../source/dataBroker
SRC_NDXPRO_DATASERVICE=../../source/dataService
SRC_NDXPRO_DATAMANAGER=../../source/dataManager
SRC_NDXPRO_AUTHORIZATION=../../source/dataAuth
SRC_NDXPRO_FILE_SERVICE=../../source/file-service

# --- Kafka / Zookeeper --------------------------------------------------------
# 이 저장소 안에 Dockerfile 이 있다. 보통 그대로 둔다.
SRC_PIPELINE_KAFKA=../fdt-service-backend/kafka/build/kafka
SRC_PIPELINE_ZOOKEEPER=../fdt-service-backend/kafka/build/zookeeper

# postgres·mongo·redis·httpd·nginx·kafka-ui 는 공개 이미지라 소스가 없다.
# build-from-source.sh 가 Docker Hub 에서 --platform 을 붙여 받아온다. 설정 불필요.
