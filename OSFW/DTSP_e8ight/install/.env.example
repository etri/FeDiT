# =============================================================================
#  디지털 연합트윈 서비스 플랫폼 - 환경변수
#  cp .env.example .env  후 [1] 부분의 주소만 서버에 맞게 고치면 된다.
#  [2] 아래는 기본값 그대로 두고 사용한다.
# =============================================================================

# -----------------------------------------------------------------------------
# [1] 여기만 고친다 — 주소
# -----------------------------------------------------------------------------
# 플랫폼이 설치되는 서버의 IP(또는 도메인)
HOST=ex)127.0.0.1

# 브라우저로 접속할 주소. 도메인+HTTPS 를 쓰면 그 주소를 적는다.
#   예) https://service.fedit.or.kr
PUBLIC_URL=http://127.0.0.1:50028

# 데이터·로그 저장 경로 (디스크 여유가 큰 경로)
REPO=/data/ndxpro

# --- 외부 연동 주소. 쓰지 않으면 값을 비워 둔다 ---
LOGSTASH_URL=172.16.28.222:50000
ZIPKIN_URL=http://172.16.28.222:59411/
DTMETA_API_URL=http://dtmeta.fedit.or.kr:16997
FDT_SYNC_API_URL=http://220.124.222.84:1221


# =============================================================================
# [2] 아래는 기본값 그대로 둔다
# =============================================================================

TZ=Asia/Seoul
DOCKER_NETWORK=ndxpro

# 이미지 이름 앞에 붙는 주소. 설치할 때 이 주소로 접속하지 않는다.
# 묶음 안의 이미지 이름과 compose 의 이름을 맞추는 용도라서 바꿀 일이 없다.
# (바꾸려면 이미지도 그 이름으로 다시 태그해야 한다)
IMAGE_REPO_URL=172.16.28.217:12000

# --- 이미지 묶음 -----------------------------------------------------------------
# 설치 서버는 레지스트리에 접속하지 않는다. 이 tar.gz 을 적재해서 쓴다.
# 경로는 이 .env 파일이 있는 곳(저장소 루트) 기준이다.
# 만드는 방법은 image-bundle/README.md 참고.
IMAGE_BUNDLE=./images/union-twin-service-images.tar.gz

# --- 계정 / 비밀번호 -----------------------------------------------------------
POSTGRES_ADMIN_USER=postgresadmin
POSTGRES_ADMIN_PASSWORD=ndxpro123!
POSTGRES_USER=ndxpro
POSTGRES_PASSWORD=ndxpro123!
POSTGRES_DB=ndxpro
UNION_TWIN_DB=union_twin

MONGO_ROOT_USER=mongoadmin
MONGO_ROOT_PASSWORD=ndxpro123!
MONGO_USER=ndxpro
MONGO_PASSWORD=ndxpro123!
MONGO_DB=ndxpro

REDIS_PASSWORD=ndxpro123!

ADMIN_SEED_PASSWORD=ndxpro123!
JWT_SECRET=DAP8u28Grzh1cjqEOhnQNFp5zCPOVxEqSZtAYYFipBF

# --- 서비스 토큰 ---------------------------------------------------------------
# NDXPro 서비스 계정 JWT. 만료되면 data-auth(:54009)에서 재발급받아 교체한다.
NDXPRO_TOKEN=eyJhbGciOiJIUzUxMiJ9.eyJpZCI6ImU4aWdodEFkbWluMiIsImF1dGgiOiJBRE1JTiIsImV4cCI6MzM2MzIwOTgwOSwiaWF0IjoxNzg2NDA5ODA5LCJzdWIiOiIxIn0.ObaKz6ob40z4LEWyL9PW1tyo-jpzx2H02hSJG53GLL4y9I8VqO2S0nfbIATm27AROVChrNxTwdhN9jY6UdLx_w
DTMETA_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJQQVQxNzI0OTgxMDQ4MDAwMTQ3IiwicGF0a1JlZ3JJZCI6Im1ldGFfYWRtaW4iLCJwYXRrUmVnck5tIjoi66mU7YOA7Iuc7Iqk7YWc6rSA66as7J6QIiwiaXNzIjoia2V0aV9kdF9tZXRhZGF0YV9hcGkiLCJpYXQiOjE3MjQ5ODEwNDd9.kl-IIKakCLQhswK2qgOcK8RxtfQw_nlCwh7E3q5sqx4

# --- NGSI-LD 컨텍스트 파일명 ----------------------------------------------------
CONTEXT_FILE=fdt-twin-context-v1.0.1.jsonld

# --- 이미지 태그 ---------------------------------------------------------------
# --- 서비스 이미지 태그 -------------------------------------------------------
# 운영 서버에 올라가 있는 버전과 동일하게 맞춘 값이다. 버전을 올릴 때만 수정한다.
TAG_EUREKA=v1.1
TAG_GATEWAY=v1.1
TAG_DATA_INGEST=v1.1
TAG_TRANSLATOR_BUILDER=v1.1.1
TAG_NGSI_TRANSLATOR=v1.1.1
TAG_DATA_BROKER=v1.1.2
TAG_DATA_SERVICE=v1.1
TAG_DATA_MANAGER=v1.1
TAG_DATA_AUTH=v1.1
TAG_FILE_SERVICE=v1.0
TAG_FDT_SERVICE=v1.1

# 연합트윈 화면은 latest 로 배포한다. (fe 는 jeju / samsung 태그도 있음)
TAG_UNION_TWIN_FE=latest
TAG_UNION_TWIN_BE=latest

# TAG_* 를 비워 두면 이 값이 쓰인다.
IMAGE_TAG=latest

# kafka/zookeeper 는 직접 빌드한 이미지다.
# 레지스트리에 올려서 쓰려면 아래를 172.16.28.217:12000/pipeline-kafka:v1 형태로 바꾼다.
IMG_KAFKA=pipeline-kafka
IMG_ZOOKEEPER=pipeline-zookeeper

# 공개 이미지(Docker Hub). 전부 버전을 고정해 두었다.
# latest 로 두면 설치 시점마다 다른 버전이 깔려 재현이 안 되고, DB 는 데이터 호환 문제로 이어진다.
# 이 묶음은 아래 버전으로 검증했다.
IMG_POSTGRES=postgres:14.1
IMG_MONGO=mongo:8.2.12
IMG_REDIS=redis:6.2
IMG_HTTPD=httpd:2.4-alpine
IMG_KAFKA_UI=provectuslabs/kafka-ui:v0.7.2
IMG_NGINX=nginx:1.31.4

# --- 호스트 공개 포트 (충돌 시에만 변경) -----------------------------------------
PORT_POSTGRES=55432
PORT_MONGO=57017
PORT_REDIS=56379

PORT_ZOOKEEPER=22181
PORT_KAFKA=19092
KAFKA_TOPIC_PARTITIONS=5
PORT_KAFKA_UI=59500


PORT_EUREKA=58761
PORT_GATEWAY=54002
PORT_DATA_INGEST=54003
PORT_NGSI_TRANSLATOR=54004
PORT_TRANSLATOR_BUILDER=54005
PORT_DATA_SERVICE=54007
PORT_DATA_MANAGER=54008
PORT_DATA_AUTH=54009
PORT_DATA_BROKER=54011
PORT_FILE_SERVICE=54020
PORT_FILE_SERVICE_ACTUATOR=54021
PORT_CONTEXT=53005

PORT_FDT_SERVICE=50038
PORT_UNION_TWIN_FE=50028
PORT_UNION_TWIN_BE=4000

# 이미지 자동 갱신(watchtower) 사용 여부
WATCHTOWER_ENABLED=false
