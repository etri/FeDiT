{
  "name": "@workspace/union-twin-be",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down -v",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint 'src/**/*.ts'",
    "lint:prettier": "prettier --check 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' && eslint --fix 'src/**/*.ts'",
    "check": "pnpm run lint && pnpm run lint:prettier && pnpm run type-check",
    "type-check": "tsc --noEmit",
    "migration:generate": "pnpm exec typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "pnpm exec typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "pnpm exec typeorm-ts-node-commonjs migration:revert -d src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/passport-jwt": "^4.0.1",
    "dotenv": "^17.4.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "ts-node": "^10.9.2",
    "typescript": "catalog:"
  }
}
