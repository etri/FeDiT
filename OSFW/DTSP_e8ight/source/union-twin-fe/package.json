{
  "name": "union-twin",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name '.turbo' -type d -prune -exec rm -rf '{}' + && find . -name 'dist' -type d -prune -exec rm -rf '{}' + && find . -name '.next' -type d -prune -exec rm -rf '{}' + && find . -name 'build' -type d -prune -exec rm -rf '{}' + && find . -name '.cache' -type d -prune -exec rm -rf '{}' +",
    "prepare": "husky",
    "lint": "turbo run lint",
    "lint:prettier": "turbo run lint:prettier",
    "format": "turbo run format",
    "check": "turbo run lint lint:prettier type-check",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "eslint": "catalog:",
    "eslint-config-next": "^15.5.21",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.10.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.6",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.17.0"
}
