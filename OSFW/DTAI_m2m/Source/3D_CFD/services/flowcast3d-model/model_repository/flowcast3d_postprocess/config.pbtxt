name: "flowcast3d_postprocess"
backend: "python"
max_batch_size: 0
input [
  { name: "NORMALIZED" data_type: TYPE_FP32 dims: [ -1, 4, -1, -1, -1 ] },
  { name: "MODEL_DETAILS" data_type: TYPE_STRING dims: [ 1 ] },
  { name: "CONTEXT" data_type: TYPE_STRING dims: [ 1 ] }
]
output [
  { name: "RESULT" data_type: TYPE_STRING dims: [ 1 ] },
  { name: "METADATA" data_type: TYPE_STRING dims: [ 1 ] }
]
instance_group [{ kind: KIND_CPU count: 1 }]
