#version 430

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct ModelInfo { uint Offset, Count, name_Index, pad; };
struct BVHNode { vec4 aabbMin, aabbMax; int leftChild, rightChild, triangleIndex, pad; };
struct Triangle { vec4 v0, v1, v2; };

struct IntersectResult {
    int hitType;       // 0~3  0:교차 없음, 1:픽셀 꼭지점 일부가 삼각형 내부, 2:삼각형 꼭지점 일부가 픽셀 내부, 3: 완전 포함(픽셀 중심점 사용)
    vec2 hitPosition;  // ray origin으로 사용할 UV 좌표
};

layout(r8, binding = 0)   uniform writeonly image2DArray lightMaps;
layout(std430, binding = 0)    readonly buffer PosBuffer      { vec4 posData[]; } posbuffer;
layout(std430, binding = 1)    readonly buffer NorBuffer      { vec4 norData[]; } norbuffer;
layout(std430, binding = 2)    readonly buffer UVBuffer       { vec2 uvData[]; } uvbuffer;
layout(std430, binding = 3)    readonly buffer ModelBuffer    { ModelInfo models[]; } modelbuffer;
layout(std430, binding = 4) readonly buffer BVHVertexBuffer { vec4 vertex[];} bvhVertex;
layout(std430, binding = 5) readonly buffer BVHIndexBuffer { uvec4 index[];} bvhIndex;
layout(std430, binding = 6) readonly buffer BVHBuffer { BVHNode bvhnode[];} bvhbuffer;

uniform int  mOffset;
uniform vec3 lightDir;
uniform float shadowSharpness;
uniform int gridSize;

// [수정] 기존의 const int GRID_SIZE = gridSize; 별칭은 GLSL 표준 위반이라 제거함.
//   (const는 컴파일 시점 상수로만 초기화 가능, uniform은 런타임 값.
//    NVIDIA는 관대하게 통과시키지만 Intel(Arc)은 컴파일 거부
//    → 빈(전부 0) Light Map 생성으로 이어짐)
const float EPSILON   = 1;   // 리터럴 초기화는 표준에 맞으므로 유지

// ============================================================================
// [수정] Barycentric 분모(denom) 판정 기준 [260716]
//
//   denom = d00*d11 - d01*d01
//         = |v0|^2 * |v1|^2 * sin^2(theta)
//         = (2 * uv_area)^2
//
// 즉 denom 은 uv_area 의 "제곱"이고, UV 변 길이의 4제곱에 비례한다.
// 따라서 절대값 비교(기존 1e-8)는 삼각형이 작을수록 무차별로 걸러버린다.
//   - 기존 abs(denom) < 1e-8  <=>  uv_area < 5e-5  <=>  1024맵에서 52텍셀
//     => 7x7 텍셀짜리 정상 삼각형까지 전부 탈락 (실측: 68.6%)
//
// 크기가 아니라 "형태(sliver 여부)"만 보도록 상대 비교로 바꾼다.
//   sin^2(theta) = denom / (d00*d11)
//
// 하한 1e-5 근거: d00/d01/d11 이 float32 dot() 결과라 denom 의 상대오차가
//   약 2*eps_f32 / sin^2(theta) = 2.4e-7 / sin^2(theta) 이다.
//   sin^2 = 1e-5 -> 오차 2.4% (유효숫자 ~2자리)로 안전.
//   sin^2 = 1e-6 -> 오차 24% 로 denom 이 무의미해진다.
// 실측 탈락: 0987.fbx 10/2154(0.5%, 전부 진짜 sliver), 089.fbx 0/3030
// ============================================================================
const float SIN2_MIN = 1e-5;   // sliver 판정 하한: sin^2(theta), theta < 0.18deg


//두 벡터 사이의 각도 계산(degree)
float angleBetweenDegrees(vec3 a, vec3 b) {
    float cosTheta = clamp(dot(normalize(a), normalize(b)), -1.0, 1.0);
    return degrees(acos(cosTheta));
}

//260721
float cross2D(vec2 a, vec2 b)
{
    return a.x * b.y - a.y * b.x;
}


// 두 선분 교차 검사 260721
bool segmentIntersect2D(
    vec2 p0, vec2 p1,
    vec2 q0, vec2 q1,
    out vec2 hitPoint)
{
    vec2 r = p1 - p0;
    vec2 s = q1 - q0;

    float denom = cross2D(r, s);

    // 평행한 경우 제외
    if (abs(denom) < 1e-12)
        return false;

    vec2 qp = q0 - p0;

    float t = cross2D(qp, s) / denom;
    float u = cross2D(qp, r) / denom;

    // 두 선분 범위 내에서 교차
    if (t >= 0.0 && t <= 1.0 &&
        u >= 0.0 && u <= 1.0)
    {
        hitPoint = p0 + t * r;
        return true;
    }

    return false;
}


// 삼각형 내부 판별 함수
bool pointInTriangle(vec2 pt, vec2 a, vec2 b, vec2 c) {
    vec2 v0 = b - a;
    vec2 v1 = c - a;
    vec2 v2 = pt - a;

    float d00 = dot(v0, v0);
    float d01 = dot(v0, v1);
    float d11 = dot(v1, v1);
    float d20 = dot(v2, v0);
    float d21 = dot(v2, v1);
    float denom = d00 * d11 - d01 * d01;

    // [수정] 관문(1): 기존 abs(denom) < 1e-8 은 크기 의존이라 정상 삼각형을 죽였다. [260716]
    //        여기서 false 가 나면 hitType 3(중심점)과 1(모서리)이 모두 막혀서
    //        메인 루프의 가드를 고쳐도 소용이 없다. 반드시 함께 고쳐야 하는 지점.
    float scale = d00 * d11;
    if (scale < 1e-30 || abs(denom) < SIN2_MIN * scale) return false;

    float v = (d11 * d20 - d01 * d21) / denom;
    float w = (d00 * d21 - d01 * d20) / denom;
    float u = 1.0 - v - w;

    // 오차 허용
    const float eps = 1e-8;
    return (u >= -eps && v >= -eps && w >= -eps);
}

// 사각형(AABB) 내부인지 판별
bool pointInRect(vec2 pt, vec2 minR, vec2 maxR) {
    return all(greaterThanEqual(pt, minR)) && all(lessThanEqual(pt, maxR));
}

// 픽셀과 UV island의 교차 확인
// 걸치며 교차하는 경우 100% 교차점을 ray-tracing 기준점으로 사용
IntersectResult intersectsFastDetailed(vec2 tri0, vec2 tri1, vec2 tri2,
                                       vec2 rect0, vec2 rect1, vec2 rect2, vec2 rect3)
{
    IntersectResult result;
    result.hitType = 0;
    result.hitPosition = vec2(0.0);

    // 1. 중심점 포함 검사
    vec2 center = (rect0 + rect2) * 0.5;
    if (pointInTriangle(center, tri0, tri1, tri2)) {
        result.hitType = 3;
        result.hitPosition = center;
        return result;
    }

    // 2. 픽셀 꼭짓점 4개 검사
    vec2 rectPoints[4] = vec2[4](rect0, rect1, rect2, rect3);
    for (int i = 0; i < 4; ++i) {
        if (pointInTriangle(rectPoints[i], tri0, tri1, tri2)) {
            result.hitType = 1;
            result.hitPosition = rectPoints[i];
            return result;
        }
    }

    // 3. 삼각형 꼭짓점이 픽셀 AABB 내부에 포함되는지 검사
    vec2 minRect = min(min(rect0, rect1), min(rect2, rect3));
    vec2 maxRect = max(max(rect0, rect1), max(rect2, rect3));
    vec2 triPoints[3] = vec2[3](tri0, tri1, tri2);

    for (int i = 0; i < 3; ++i) {
        if (pointInRect(triPoints[i], minRect, maxRect)) {
            result.hitType = 2;
            result.hitPosition = triPoints[i];
            return result;
        }
    }

    // 4. 삼각형 선분과 픽셀 4개 모서리의 교차 검사 260721 추가함
    vec2 tristart[3] = vec2[3](tri0, tri1, tri2 );
    vec2 triend[3] = vec2[3](tri1, tri2, tri0);
    vec2 rectstart[4] = vec2[4](rect0, rect1, rect2, rect3);
    vec2 rectend[4] = vec2[4](rect1, rect2, rect3, rect0);

    for (int t = 0; t < 3; ++t)
    {
        for (int r = 0; r < 4; ++r)
        {
            vec2 hitpoint;

            if (segmentIntersect2D(
                tristart[t],
                triend[t],
                rectstart[r],
                rectend[r],
                hitpoint))
            {
                result.hitType = 3;
                result.hitPosition = hitpoint;
                return result;
            }
        }
    }

    return result; // hitType = 0 by default
}


// AABB 교차 검사
bool intersectAABB(vec3 orig, vec3 dir, vec3 mn, vec3 mx) {
    vec3 inv = 1.0/dir;
    vec3 t0 = (mn - orig)*inv;
    vec3 t1 = (mx - orig)*inv;
    vec3 tmin3 = min(t0,t1), tmax3 = max(t0,t1);
    float tmin = max(max(tmin3.x,tmin3.y), tmin3.z);
    float tmax = min(min(tmax3.x,tmax3.y), tmax3.z);
    return tmax >= max(tmin, 0.0);
}

// Möller–Trumbore 삼각형 교차
//교차 검증만 할것이기 때문에 삼각형에서의 교차 위치 계산 필요는 없음-> u,v,w값 필요 없 음
bool intersectTriangle(vec3 orig, vec3 dir, int triIndex) {

    uvec4 triIdx = bvhIndex.index[triIndex];

    vec3 v0 = bvhVertex.vertex[triIdx.x].xyz;
    vec3 v1 = bvhVertex.vertex[triIdx.y].xyz;
    vec3 v2 = bvhVertex.vertex[triIdx.z].xyz;

    vec3 u = v1 - v0;
    vec3 v = v2 - v0;
    vec3 n = cross(u, v);

    float denom = dot(n, dir);
    if(abs(denom) < 1e-7) return false; // 삼각형이 이루는 평면과 dir이 평행이면 여기서 계산 종료

    float t = dot(n, v0 - orig) / denom;
    if (t < 0.0) return false; // 교점이 광선 뒤쪽

    vec3 p = orig + t * dir; // 삼각형이 이루는 평면과 광선의 교점 계산

    vec3 w = p - v0;

    float uu = dot(u, u);
    float uv = dot(u, v);
    float vv = dot(v, v);
    float wu = dot(w, u);
    float wv = dot(w, v);

    float denomTri = uv * uv - uu * vv;
	float s = (uv * wv - vv * wu) / denomTri;
	float tBary = (uv * wu - uu * wv) / denomTri;

    return (s >= 0 && tBary >= 0 && s + tBary <= 1); // 삼각형 내부 확인
}

bool almostEqual(vec3 a, vec3 b, float tol) {
    return all(lessThan(abs(a - b), vec3(tol)));
}

// BVH 스택 탐색 : 최대 maxHits개까지 교차 확인하여 차폐물 수 반환
int traverseBVH_CountHitsUpTo(int root, vec3 orig, vec3 dir,
                              vec3 p0_ref, vec3 p1_ref, vec3 p2_ref,
                              int maxHits)
{
    const int MAX_STK = 64;
    int stack[MAX_STK], sp = 0;
    stack[sp++] = root;

    int hitCount = 0;

    while (sp > 0) {
        BVHNode n = bvhbuffer.bvhnode[stack[--sp]];
        if (!intersectAABB(orig, dir, n.aabbMin.xyz, n.aabbMax.xyz))
            continue;

        if (n.triangleIndex >= 0) {
            uvec4 triIdx = bvhIndex.index[n.triangleIndex];

            vec3 v0 = bvhVertex.vertex[triIdx.x].xyz;
            vec3 v1 = bvhVertex.vertex[triIdx.y].xyz;
            vec3 v2 = bvhVertex.vertex[triIdx.z].xyz;

            // self-intersection 방지
            bool same0 = almostEqual(v0.xyz, p0_ref, 1e-2) ||
                         almostEqual(v0.xyz, p1_ref, 1e-2) ||
                         almostEqual(v0.xyz, p2_ref, 1e-2);

            bool same1 = almostEqual(v1.xyz, p0_ref, 1e-2) ||
                         almostEqual(v1.xyz, p1_ref, 1e-2) ||
                         almostEqual(v1.xyz, p2_ref, 1e-2);

            bool same2 = almostEqual(v2.xyz, p0_ref, 1e-2) ||
                         almostEqual(v2.xyz, p1_ref, 1e-2) ||
                         almostEqual(v2.xyz, p2_ref, 1e-2);

            if (same0 && same1 && same2)
            {
                continue;
            }

            if (intersectTriangle(orig, dir, n.triangleIndex)) {
                hitCount++;
                if (hitCount >= maxHits)
                    return maxHits; // 조기 종료
            }
        } else {
            if (n.leftChild >= 0 && sp < MAX_STK) stack[sp++] = n.leftChild;
            if (n.rightChild >= 0 && sp < MAX_STK) stack[sp++] = n.rightChild;
        }
    }

    return hitCount; // 최대 maxHits
}






///////////////////////////////
void sampleOcclusion(vec3 origin, vec3 lightDir, vec3 tangent, vec3 bitangent,
                     vec3 p0, vec3 p1, vec3 p2,
                     out float occCount, int count)
{
    occCount = 0.0;
    for (int gx = 0; gx < gridSize; ++gx) {
        for (int gy = 0; gy < gridSize; ++gy) {
            vec3 jitterDir = normalize(
                lightDir
                + ((float(gx) - float(gridSize - 1) * 0.5) / float(gridSize)) * shadowSharpness * tangent
                + ((float(gy) - float(gridSize - 1) * 0.5) / float(gridSize)) * shadowSharpness * bitangent
                );
                
                int block = traverseBVH_CountHitsUpTo(0, origin, jitterDir, p0, p1, p2, count);
                
                if(block >= count) occCount++;
                
        }
    }

}
///////////////////////////////



void main(){
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    int  midx = int(gl_GlobalInvocationID.z);
    ModelInfo info = modelbuffer.models[midx];

    vec2 uv_min = vec2(pix) / vec2(imageSize(lightMaps).xy);
    vec2 uv_max = (vec2(pix) + 1.0) / vec2(imageSize(lightMaps).xy);

    //픽셀의 4개의 꼭지점 구하기
    vec2 uv0 = uv_min;                      //좌하단
    vec2 uv1 = vec2(uv_max.x, uv_min.y);    //우하단
    vec2 uv2 = uv_max;                      //우상단
    vec2 uv3 = vec2(uv_min.x, uv_max.y);    //좌상단

    // <1>  UV -> world-space 에서의 좌표 계산
    uint off = info.Offset - mOffset;
    uint cnt = info.Count;

    vec3 p0, p1, p2, n0, n1, n2; // world space 상에서의 삼각요소의 3개의 정점
    vec3 pos; // world space 상에서의 해당 픽셀의 위치
    vec3 nor; // 해당 픽셀의 normal vector 값(삼각요소 정점을 기반으로한 보간 계산)

    bool found = false;

    for(uint t = 0 ; t < cnt/3 ; ++t){
        
        vec2 u0 = uvbuffer.uvData[off + t*3 + 0];
        vec2 u1 = uvbuffer.uvData[off + t*3 + 1];
        vec2 u2 = uvbuffer.uvData[off + t*3 + 2];

        // 형상 이상으로 인해 발생하는 잘못된 형상의 UV Map 회피//
        // -- UV 삼각형 면적이 너무 작은 경우 --
        vec2 uv_edge1 = u1 - u0;
        vec2 uv_edge2 = u2 - u0;
        float uv_area = abs(uv_edge1.x * uv_edge2.y - uv_edge1.y * uv_edge2.x) * 0.5;
        if (uv_area < 1e-12) continue; //260721 UV Island 많은 형상을 다루다 보니 UV Island 면적이 작아서 수치를 높힘
        ////////////////////////////////////////////////////
    
        
        //삼각 요소와 픽셀이 곂치는지 정밀 검사하기(픽셀이 삼각요소에 살짝만 걸쳐도 교차 판정함)
        IntersectResult hit = intersectsFastDetailed(u0, u1, u2, uv0, uv1, uv2, uv3);

         if (hit.hitType > 0) {//hit.hitType = 0 -> 픽셀과 삼각요소 곂치지 않음

            vec2 uv = hit.hitPosition;

            //Barycentric 좌표
            vec2 dv0 = u1 - u0;
            vec2 dv1 = u2 - u0;
            vec2 dv2 = uv - u0;

            double d00 = dot(dv0, dv0);
            double d01 = dot(dv0, dv1);
            double d11 = dot(dv1, dv1);
            double d20 = dot(dv2, dv0);
            double d21 = dot(dv2, dv1);

            double denom = d00 * d11 - d01 * d01;


            ////////////////////////////////////////////////////
            // 2. 형상이 이상으로 인해 발생한 잘못된 형상의 UV Map 회피 [260716]
            // ---  Barycentric 분모가 너무 작으면 스킵 ---
            // [수정] 관문(2): 기존 abs(denom) < 1e-8 은 절대값 비교라
            //        UV 삼각형 크기의 4제곱에 좌우됐다. pointInTriangle 과
            //        같은 기준(sin^2(theta) 하한)으로 통일한다.
            double scale = d00 * d11;
            if (scale < 1e-30 || abs(denom) < SIN2_MIN * scale) continue;
            ////////////////////////////////////////////////////


            double invDenom = 1.0 / denom;
            double v = (d11 * d20 - d01 * d21) * invDenom;
            double w = (d00 * d21 - d01 * d20) * invDenom;
            double u = 1.0 - v - w;     


            p0 = posbuffer.posData[off + t*3 + 0].xyz;
            p1 = posbuffer.posData[off + t*3 + 1].xyz;
            p2 = posbuffer.posData[off + t*3 + 2].xyz;

            n0 = norbuffer.norData[off + t*3 + 0].xyz;
            n1 = norbuffer.norData[off + t*3 + 1].xyz;
            n2 = norbuffer.norData[off + t*3 + 2].xyz;


            ////////////////////////////////////////////////////
            // 3. 형상이 이상으로 인해 발생한 잘못된 형상의 UV Map 회피
            // ---  3D 삼각형 면적이 너무 작으면 스킵 ---
            vec3 edge1_3d = p1 - p0;
            vec3 edge2_3d = p2 - p0;
            float area3D = length(cross(edge1_3d, edge2_3d)) * 0.5;
            if (area3D < 1e-8) continue;
            ////////////////////////////////////////////////////

            pos = vec3(u * p0 + v * p1 + w * p2);

            nor = vec3(u * n0 + v * n1 + w * n2);

            found = true;

            break; //해당 픽셀이 속한 UVmap 상의 Island를 찾았기 때문에 추가로 loop를 돌릴 필요가 없음
        }         
    }

    float shadow = 0.0;  // 기본적으로 그림자가 없는 검은(0.0)값 유지

    if(found){//해당 픽셀이 Island에 속해 있으면 아래 코드 실행
    
        vec3 lightDirNorm = normalize(lightDir);
        vec3 V_N = normalize(nor); //정점 법선 벡터
        vec3 F_N = normalize(cross(p1 - p0, p2 - p0));  // 면 법선 벡터

        // F_N이 V_N과 90도 초과일 경우 반전
        if (dot(V_N, F_N) < 0.0) {
            F_N = -F_N;
        }

        //fakeDir을 통해 tangent와 bitangent를 계산하여 격자 방향 설정함
        //처음에는 x,y,z*1.2를 사용했는데 이러니 광원 방향이 0,0,a 인 경우 오류 발생함
        // 회전, 평행 이동 크기가 크면 방향이 왜곡될 위험이 있음
        // Step 1: 약간 평행 이동
        vec3 offsetDir = normalize(lightDirNorm + vec3(0.005, 0.003, 0.0));  // XY 축에 살짝 이동

        // Step 2: Z축 회전
        float angle = radians(3.0);
        float cosA = cos(angle);
        float sinA = sin(angle);

        mat3 rotZ = mat3(
            vec3(cosA, -sinA, 0.0),
            vec3(sinA,  cosA, 0.0),
            vec3(0.0,   0.0,  1.0)
        );

        vec3 fakeLightDir = normalize(rotZ * offsetDir);

        // Step 3: tangent, bitangent 계산
        vec3 tangent   = normalize(cross(lightDirNorm, fakeLightDir));
        vec3 bitangent = normalize(cross(tangent, lightDirNorm));        
  
        //vec3 origin = pos + lightDirNorm * EPSILON; 
        vec3 origin = pos + F_N * EPSILON; 


        // Calculate shadow
        int sampleCount = gridSize*gridSize;
        float occl=0.0;  //grid sample에서 가려진 개수

        float min_angle = 30;
        float max_angle = 90;

        if (angleBetweenDegrees(lightDirNorm, F_N) < max_angle) {
            sampleOcclusion(origin, lightDirNorm, tangent, bitangent, p0, p1, p2, occl, 1);
        } else {
            sampleOcclusion(origin, lightDirNorm, tangent, bitangent, p0, p1, p2, occl, 2);
        }
        shadow = min(smoothstep(max_angle, min_angle, angleBetweenDegrees(lightDirNorm, V_N)), 1.0 - occl / float(sampleCount));

        //light map에서 "0"은 UV Island의 내외를 판별하기 위한 기준으로 사용
        shadow = (floor(clamp(shadow, 0.0, 1.0) * 254.0 + 0.5) + 1.0) / 255.0;

    }    

    //imageStore은 vec4타입 값을 요구하기 때문에 R8 텍스처를 사용하더라도 RGBA로 명시해한다
    //R8인 경우 입력된 RGBA에서 R 값만 저장됨
    imageStore(lightMaps, ivec3(pix,midx), vec4(shadow, 0.0, 0.0, 1.0));
}