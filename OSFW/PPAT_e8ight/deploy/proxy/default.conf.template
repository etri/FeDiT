# 서버 한 대의 앞단(nginx). 밖에서 들어오는 요청을 받아 안쪽 컨테이너로 넘긴다. 길 나누기는 locations.conf 에 있다.
#   https://${PUBLIC_HOST}/            → renderer(시작·전처리·물리 시뮬레이션·후처리 페이지). FeDiT 는 iframe 으로 띄우기만 한다
#   https://${PUBLIC_HOST}/engine/...  → engine(해석엔진 API, 앞부분 /engine 을 떼고 넘김). GET·POST 만
#   https://${PUBLIC_HOST}/results/... → 엔진 작업 폴더(읽기 전용). 후처리가 결과를 바로 읽는다
# 컨테이너가 시작할 때 nginx 이미지가 정의된 환경 변수(${...})만 값으로 바꿔 /etc/nginx/conf.d/default.conf 를 만든다.
# $cookie_cfd_key 처럼 같은 이름의 환경 변수가 없는 것은 nginx 변수로 그대로 남는다.

server_tokens off;
# nginx 가 만드는 되돌려 보내기(폴더 주소에 / 붙이기)를 상대 주소로 한다(안쪽 포트 8080 이 밖으로 새지 않게)
absolute_redirect off;
# 안쪽 컨테이너 이름은 요청 때마다 Docker 내부 DNS 로 찾는다(하나가 꺼져 있어도 앞단은 뜨고, 다시 만들어져 주소가 바뀌어도 따라간다)
resolver 127.0.0.11 valid=10s ipv6=off;

# 해석 실행 허락: 접근 키(ACCESS_KEY)를 비워 두면 늘 1, 넣어 두면 쿠키 cfd_key 가 그 값과 같을 때만 1.
# 키 비교는 정규식(~, 대소문자 구분)으로 한다 — map 의 문자열 비교는 대소문자를 가리지 않는다.
map "${ACCESS_KEY}:$cookie_cfd_key" $cfd_run_ok {
    default 0;
    "~^:" 1;
    "~^${ACCESS_KEY}:${ACCESS_KEY}$" 1;
}

# 허락 없이 POST(해석 실행)하면 1 → locations.conf 의 /engine/ 이 401 로 막는다. 조회(GET)는 늘 열려 있다
map "$request_method:$cfd_run_ok" $engine_block {
    default 0;
    "POST:0" 1;
}

# 해석 실행(POST)만 접속 주소(IP)별로 세어 제한한다(열어 둔 채로 한 곳이 대기열·메모리를 채우지 못하게). 키가 빈 요청(GET 등)은 세지 않는다
map $request_method $jobs_post_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone  $jobs_post_key zone=jobs_post:1m rate=10r/m;
limit_conn_zone $jobs_post_key zone=jobs_post_conn:1m;

# http → https
server {
    listen 80;
    server_name ${PUBLIC_HOST};
    return 301 https://${PUBLIC_HOST}$request_uri;
}

# https (밖에서 들어오는 길)
server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    # 다시 접속할 때는 위 서버 쪽 캐시만 쓰고 세션 티켓은 끈다(티켓 키 교체 결함 CVE-2026-97629 를 피함, 2026-10-29)
    ssl_session_tickets off;

    # 안쪽 주소(컨테이너 이름:포트). 변수로 두어야 위 resolver 로 요청 때마다 찾는다
    set $renderer_upstream http://${RENDERER_UPSTREAM};
    set $engine_upstream http://${ENGINE_UPSTREAM};
    include /etc/nginx/cfd/locations.conf;
}

# http 8080 (안쪽 확인용). compose 가 서버의 127.0.0.1 에만 연다 — 이 PC 리허설과 서버 안에서의 확인에 쓴다
server {
    listen 8080 default_server;
    server_name _;

    set $renderer_upstream http://${RENDERER_UPSTREAM};
    set $engine_upstream http://${ENGINE_UPSTREAM};
    include /etc/nginx/cfd/locations.conf;
}
