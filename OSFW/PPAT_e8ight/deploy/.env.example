# deploy/.env 로 복사해 이 서버에 맞게 적는다. deploy/.env 는 저장소에 올리지 않는다.
# 두 가지로 쓴다(README 2·5절):
#   이 PC 리허설 — 엔진까지 함께 띄운다(--profile engine 또는 아래 COMPOSE_PROFILES=engine)
#   E8IGHT 서버  — renderer + proxy 만. 엔진은 1세부 compose 가 띄우고, docker-compose.server.yml 을 겹쳐 쓴다

# ── 공개 주소와 https 앞단(proxy) ─────────────────────────────
# 페이지 주소 이름. 인증서(*.fedit.or.kr)에 맞아야 한다
PUBLIC_HOST=cfd.fedit.or.kr
# 인증서 폴더: fullchain.pem(서버 인증서 + 중간 인증서) · privkey.pem(비밀 키). 저장소에 넣지 않는다(/deploy/certs/ 는 .gitignore)
# 서버에서는 비밀 키를 chmod 600 으로 둔다
CERT_DIR=./certs
# 해석 실행 접근 키. 비우면 로그인·키 없이 열려 있다.
# 넣으면 해석 실행(POST engine/jobs)만 쿠키 cfd_key 를 확인한다. 16자 이상, 영문·숫자·_·- 만. 만들기: openssl rand -hex 16
ACCESS_KEY=
# 밖에서 들어오는 포트(80 → https 되돌림, 443 https). 이 PC 리허설은 127.0.0.1(이 PC 안에서만), E8IGHT 서버는 0.0.0.0(밖에 연다)
PROXY_BIND=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
# 안쪽 확인용 http 포트(127.0.0.1 에만 연다). 이 PC 리허설에서는 http://127.0.0.1:8090/ 으로 연다
PROXY_LOCAL_PORT=8090

# ── 페이지(renderer) ─────────────────────────────────────────
# 앞단을 거치지 않고 바로 여는 주소와 포트(확인용). 보통은 그대로 둔다
RENDERER_BIND=127.0.0.1
RENDERER_PORT=8088
# 이 페이지를 iframe 으로 띄울 수 있는 출처. * = 제한 없음. 호스트 주소가 정해지면 좁힌다
# 예: FRAME_ANCESTORS="'self' https://service.fedit.or.kr"   (작은따옴표째 큰따옴표로 감싼다)
FRAME_ANCESTORS=*

# ── 작업 폴더 ────────────────────────────────────────────────
# 해석 입력과 결과가 쌓이는 엔진 작업 폴더(한 건에 수 GB~수십 GB). proxy 가 읽기 전용으로 붙여 results/ 로 내준다
# 이 PC 리허설: 비워 두면 ./jobs (우리 engine 이 쓰는 곳)
# E8IGHT 서버: 꼭 적는다. 1세부 엔진의 작업 폴더 절대 경로. 예: <엔진 폴더>/integration/jobs (서버에서 확인)
#   서버 덧붙임 설정은 이 값이 없으면 멈춘다 — 그래서 여기 주석으로 둔다(복사한 채 잊으면 빈 ./jobs 를 붙여 결과가 안 보인다)
# JOBS_HOST_DIR=

# ── E8IGHT 서버 전용 ─────────────────────────────────────────
# 1세부 compose(프로젝트 integration)가 만든 Docker 네트워크. proxy 가 여기에 붙어 서비스 이름 engine 을 찾는다. 확인: docker network ls
ENGINE_NETWORK=integration_default

# ── 이 PC 리허설 전용: 해석엔진(engine) ──────────────────────
# 주석을 풀면 deploy 폴더의 docker compose 명령이 늘 engine 까지 함께 다룬다(--profile engine 을 붙이지 않아도 됨)
# COMPOSE_PROFILES=engine
# 1세부 해석엔진 패키지 폴더(FeDiT 저장소 OPFW/modeling_simulation_engines). 이 폴더의 integration/Dockerfile 로 빌드한다
# ENGINE_DIR=<FeDiT 저장소>/OPFW/modeling_simulation_engines   (리허설 때 주석을 풀고 이 PC 의 경로를 적는다)
# GPU 코드 캐시: 빌드 대상 밖 GPU에서 드라이버가 컴파일한 코드를 남긴다. 지우면 다음 해석 때 다시 컴파일한다
NVCACHE_HOST_DIR=./nvcache
# 엔진 API 포트(127.0.0.1 에만 연다). 밖에서는 proxy 의 engine/ 으로만 닿는다
ENGINE_PORT=18080
# 완료 알림을 받을 주소와 Bearer 토큰. 비우면 알림 없이 돌고 GET engine/jobs/<id> 로 상태를 본다(물리 시뮬레이션 페이지가 이렇게 본다)
FEDIT_RESULT_URL=
FEDIT_RESULT_TOKEN=
