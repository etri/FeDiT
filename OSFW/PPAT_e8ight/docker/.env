# ============================================
# Environment variable configuration template
# Copy this file to .env and set actual values
# ============================================

# === Deployment configuration ===
# Docker image name
IMAGE_NAME=iitp_pre_web
# Docker image version tag
VERSION=latest
# Nginx port (port accessible from host)
NGINX_PORT=3717

# ============================================
# API and service URL configuration
# ============================================

# === Development environment example ===
VITE_API_URL=http://172.16.37.55:13000/api
VITE_ENV_MODE=production

# === Production environment ===
# VITE_API_URL=http://172.16.38.8:13000/api
# VITE_ENV_MODE=production

# ============================================
# Additional configuration (optional)
# ============================================

# Log level (debug, info, warn, error)
# VITE_LOG_LEVEL=info

# Feature flags
# VITE_FEATURE_NEW_UI=false
# VITE_FEATURE_BETA=false

# Analytics tools
# VITE_GA_ID=UA-XXXXXXXXX-X
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx