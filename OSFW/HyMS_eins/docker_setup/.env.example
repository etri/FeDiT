# ============================================
# HyMS_eins Docker Environment Variables
# ============================================
# .env 파일로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env
#
# 주의 : .env 가 없으면 docker-compose up -d 가 DB 비밀번호를 빈 값으로
#        넘겨 MariaDB 가 기동하지 못합니다. 반드시 먼저 만들어 두세요.

# --- MariaDB ---
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=model_designer
MYSQL_USER=model_designer
MYSQL_PASSWORD=CHANGE_ME

# --- Node.js DB Connection ---
# DB_PASSWORD 는 MYSQL_PASSWORD 와 같은 값이어야 합니다.
DB_HOST=172.28.0.4
DB_PORT=3306
DB_NAME=model_designer
DB_USER=model_designer
DB_PASSWORD=CHANGE_ME
DB_CONNECTION_LIMIT=4

# --- Node.js Server ---
NODE_PORT=8081
# --- 배포 서버 ---
# SERVER_HOST 는 자체 서명 인증서의 CN/SAN 에도 사용된다.
#   도메인이면 SAN 에 DNS:<도메인>, IP 면 SAN 에 IP:<주소> 로 들어간다.
# 공인 인증서(web_conf/certs/server.crt)가 있으면 생성 단계는 건너뛰므로
# 이 값은 인증서에 영향을 주지 않는다.
SERVER_HOST=simulation.fedit.or.kr
HTTP_PORT=80
HTTPS_PORT=443
DB_EXT_PORT=3307

# UI 공개 주소 (Nginx /simulation 라우트 + HTTPS)
PUBLIC_BASE_URL=https://simulation.fedit.or.kr/simulation

# 외부 시스템이 이산사건 시뮬레이터를 호출할 때 사용하는 주소
#   GET  $ENV_DISCRETE_SIMULATOR_URL/api/sim/run?id=<webid>&projectname=<proj>&end_t=<sec>
# HTTPS 로 통일한다. 다만 기존에 평문 http:// 로 호출하던 연동도 그대로 동작한다.
#   - /api/..., /sim, /model, /get_*, /set_* 는 80 에서 리다이렉트 없이 그대로 프록시
#     (api_locations.conf 의 정규식 location 이 `location /` 리다이렉트보다 우선)
#   - UI(정적 파일) 요청만 80 -> 443 으로 301 리다이렉트
ENV_DISCRETE_SIMULATOR_URL=https://simulation.fedit.or.kr

# --- 순수 Linux Docker 엔진에서 돌릴 때만 주석 해제 ---
# Windows(Docker Desktop) 서버에서는 절대 켜지 말 것.
# COMPOSE_PATH_SEPARATOR 를 함께 지정해야 한다.
# (Windows 에서 compose 의 기본 구분자는 ';' 라서 ':' 만 쓰면 무시된다)
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yaml:docker-compose.linux.yaml
