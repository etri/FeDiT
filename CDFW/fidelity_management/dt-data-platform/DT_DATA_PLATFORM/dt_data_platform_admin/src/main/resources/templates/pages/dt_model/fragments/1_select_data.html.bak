<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:th="http://www.thymeleaf.org" xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout">
<th:block th:fragment="select_data">
        <div class="row">
			<div class="col-lg-12 grid-margin stretch-card">
				<div class="card">
					<div class="card-body">
						<th:block th:if="${formType == 'I'}">
							<div class="form-group mb-0 row">
								<div class="col-lg-2">
									<label class="col-form-label">데이터유형선택</label><br/>
								</div>
								<div class="col-lg-10">
		                            <div class="form-check form-check-inline">
		                                <label class="form-check-label">
		                                    <input type="radio" class="form-check-input" name="dtUseType" value="F" data-label="공개" th:checked="*{dtUseType == 'Y' or rlsYn == null}">파일업로드
		                                    <i class="input-frame"></i>
		                                </label>
		                            </div>								
		                            <div class="form-check form-check-inline">
		                                <label class="form-check-label">
		                                <!--  th:checked="*{rlsYn == 'N' or rlsYn == null}" -->
		                                    <input type="radio" class="form-check-input" name="dtUseType" value="M" data-label="비공개" th:checked="*{dtUseType == 'N'}">메타연계
		                                    <i class="input-frame"></i>
		                                </label>
		                            </div>
								</div>
							</div>
						</th:block>
					</div>
				</div>
			</div>
			
			
			<div class="col-lg-12 grid-margin stretch-card">
				<div class="card file-upload-data">
					<div class="card-body">
						<div class="form-group mb-0 row">
							<div class="col-lg-2">
								<label class="col-form-label">사용자데이터</label>
							</div>
                                    <div class="col-lg-10">
                                        <th:block th:if="${not #lists.isEmpty(dataFileList)}" th:each="item : ${dataFileList}">
                                            <div class="pt-2 attach-file">
                                                <div class="input-group">
                                                    <a th:href="@{|/file/download/dt/${item.file_seq}|}" class="file-download mt-1 mr-2" th:text="${item.strg_file_nm}">파일명</a>
                                                    
                                                    <span class="input-group-append">
                                                        <!-- <button type="button" class="btn btn-danger btn-delete-file" th:data-file-seq="${item.file_seq}">삭제</button> -->
                                                    </span>
                                                </div>
                                            </div>
                                        </th:block>
                                    
                                        <div class="attach-file-group">
                                            <!-- <div class="pt-2 attach-file" th:if="${#lists.isEmpty(fileList) || #lists.size(fileList) < 5}"> -->
                                            <div class="pt-2 attach-file" th:if="${#lists.isEmpty(fileList)}">
                                                <input type="file" name="attachFilesCsv" id="attachFilesCsv" class="file-upload-default">

                                                <div class="input-group">
                                                    <input type="text" class="form-control file-upload-title" disabled="disabled" placeholder="">
                                                    <span class="input-group-append">
                                                        <button type="button" class="file-upload-browse btn btn-primary">파일선택</button>
                                                        <!-- <button type="button" class="btn btn-danger btn-delete-upload ml-3">삭제</button> -->
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="text-danger mt-2">
                                            <!-- 첨부파일은 한 파일당 100MB, 총 300MB까지 업로드 가능합니다. -->
                                        </div>
                                    </div>
						</div>						
					</div>
					
				</div>
			
				
				
				<div class="card meta-data">
					<div class="card-body">
						<div class="form-group mb-0 row">
							<div class="col-lg-1">
								<label class="col-form-label">메타데이터</label>
							</div>
                                    <div class="col-lg-11">
					                    <div class="table-responsive-meta">
					                        <table class="table table-hover" id="metaListDataTable">
					                            <colgroup>
					                                <col style="width: 20%;">
					                                <col style="width: 20%;">
					                                <col style="width: 30%;">
					                                <col>
					                            </colgroup>
					                            <thead>
					                                <tr>
					                                    <th>No.</th>
					                                    <th>SDT_NM</th>
					                                    <th>SDT_DATA_URL</th>
					                                    <th></th>
					                                </tr>
					                            </thead>
					                            <tbody>
					                                <th:block th:include="fragments/table_empty:: table_empty(3)" th:if="${#lists.isEmpty(list)}"></th:block>
					                                <tr th:each="item, rows : ${list}" th:unless="${#lists.isEmpty(list)}">
					                                    <td th:text="${total - rows.index}"></td>
					                                    <td>
					                                     	<!-- <a th:href="@{|/meta/${item.origin_meta_seq}?${pageParams}|}" class="btn-pop-artist" th:text="${item.sdt_nm}">제목</a> -->
					                                     	<a th:text="${item.sdt_nm}">제목</a>
					                                    </td>
					                                    <td th:text="${item.sdt_data_url}"></td>
					                                    <td><button type="button" class="btn btn-primary btn-icon btn-pop-api-view ml-1" th:data-meta-seq="${item.meta_seq}" style="width: 100px">상세보기</button></td>
					                                </tr>
					                            </tbody>
					                        </table>
					                    </div>
                                    </div>
                                    
						</div>						
					</div>

					
				</div>				
			</div>				
					
		</div>
							
					
		
		
</th:block>

</html>