# Platform Admin API 설정값
#
# 이 파일을 .env 로 복사한 뒤 값을 채워 사용한다.
#   cp .env.example .env
#   docker run --env-file .env ...
#
# 값을 지정하지 않으면 application-env.yml 의 기본값(아래 주석의 값)이 쓰인다.
# 따옴표는 값의 일부로 취급되므로 붙이지 않는다.

# --- 프로필 ----------------------------------------------------------------
# 도커 설치는 dev. 이미지에 기본으로 들어 있어 생략해도 된다.
SPRING_PROFILES_ACTIVE=dev

# --- 서버 주소 -------------------------------------------------------------
# 첨부파일 다운로드 URL 에 쓰는 이 서버의 주소. 기본값 localhost
SERVER_HOST=

# --- 데이터베이스 ----------------------------------------------------------
# 컨테이너에서 호스트 PostgreSQL 로 나가는 도커 게이트웨이. 기본값 172.25.0.1
DB_HOST=
# 기본값 meta_manager
DB_USERNAME=
# 기본값 rhksflwk1!
DB_PASSWORD=

# --- 관리자 계정 -----------------------------------------------------------
# 최고 관리자로 취급할 계정 ID. 기본값 meta_admin
SUPER_ADMIN=
