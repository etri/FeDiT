# Metadata API 설정값
#
# 이 파일을 .env 로 복사한 뒤 값을 채워 사용한다.
#   cp .env.example .env
#   docker run --env-file .env ...
#
# 값을 지정하지 않으면 application-env.yml 의 기본값(아래 주석의 값)이 쓰인다.
# 따옴표는 값의 일부로 취급되므로 붙이지 않는다.
#
# 저장소들은 컨테이너명(virtuoso / neo4j / elasticsearch / influxdb2)으로 접속하므로
# 주소를 지정할 항목이 없다. PostgreSQL 만 컨테이너 밖이라 DB_HOST 를 쓴다.

# --- 프로필 ----------------------------------------------------------------
# 도커 설치는 dev. 이미지에 기본으로 들어 있어 생략해도 된다.
SPRING_PROFILES_ACTIVE=dev

# --- 반드시 지정 -----------------------------------------------------------

# InfluxDB 관리자 토큰. 기본값이 없으므로 6장에서 생성한 값을 반드시 넣는다.
INFLUX_TOKEN=

# --- 운영 시 반드시 변경 ----------------------------------------------------

# PAT(개인 액세스 토큰) 서명·검증용 대칭키 (application-env.yml 의 security.secret-key)
# 소스에 기본값이 들어 있어 지정하지 않아도 동작하지만, 그 값은 공개되어 있으므로
# 운영 서버에서는 반드시 새로 만들어 지정한다. 그대로 두면 PAT 를 위조할 수 있다.
#
# 이 서버가 발급한 PAT 를 이 서버가 검증할 때만 쓰므로 서버마다 달라도 된다.
# 인증 서버의 keys/*.pem 과는 무관하다.
# HS256 을 쓰므로 32자 이상이어야 한다. 짧으면 기동 시 WeakKeyException 이 난다.
#   openssl rand -base64 32
SECURITY_SECRET_KEY=

# --- 서버 주소 -------------------------------------------------------------
# 브라우저가 접속하는 웹 주소. 기본값 http://localhost:8084
# RDF 네임스페이스에 쓰이므로 DB 에 넣은 값과 같아야 한다.
WEB_SERVER_URL=

# 관리 화면(Conductor/Kibana/Neo4j/InfluxDB) 링크에 쓰는 서버 주소. 기본값 localhost
SERVER_HOST=

# 외부 카프카 서버. 기본값 localhost:9092
KAFKA_SERVERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=

# --- 계정 / 비밀번호 --------------------------------------------------------
# 기본값을 그대로 쓸 항목은 비워 둔다.

# PostgreSQL. 기본값 172.25.0.1 / meta_manager / rhksflwk1!
DB_HOST=
DB_USERNAME=
DB_PASSWORD=

# Virtuoso. 기본값 meta_manager / rhksflwk1!
VIRTUOSO_USERNAME=
VIRTUOSO_PASSWORD=

# Neo4j. 기본값 neo4j / rhksflwk1!
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Elasticsearch. 기본값 elastic / rhksflwk1!
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
# https 를 쓸 때만 필요
ELASTIC_FINGERPRINT=

# InfluxDB. 기본값 meta_manager / rhksflwk1!
INFLUX_USERNAME=
INFLUX_PASSWORD=
