# Dockerfile.dev

# 기본 이미지 (Python + 최신 도구 포함)
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    TRANSFORMERS_CACHE=/app/.cache/hf

# 타임존/기본 타임존 & 파이썬 모듈 경로
ENV TZ=Asia/Seoul
ENV DEFAULT_TZ_NAME=${DEFAULT_TZ_NAME:-Asia/Seoul}
ENV PYTHONPATH=/app/src

# 환경 변수 기본값 설정
ENV SERVER_ENV=.env.dev

# 작업 디렉토리
WORKDIR /app

# 시스템 필수 패키지 (빌드툴은 나중에 제거)
RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc build-essential curl ca-certificates tzdata \
  && rm -rf /var/lib/apt/lists/*

# ---- 파이썬 의존성 설치 ----
# 1) torch는 CPU wheel 인덱스에서 (공식 CPU 전용 wheel, 소스빌드 방지)
RUN pip install --no-cache-dir --prefer-binary \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.3.1 torchvision==0.18.1 torchaudio==2.3.1

# 2) 나머지 requirements는 기본 PyPI에서 설치
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --prefer-binary -r requirements.txt

# (선택) 빌드 타임 스모크 테스트
RUN python - <<'PY'
import torch, langchain, pkgutil
print("torch:", torch.__version__)
print("langchain:", langchain.__version__)
import importlib
for m in ["langchain_community","langchain_elasticsearch"]:
    mod = importlib.import_module(m)
    print(m, getattr(mod, "__version__", ""))
PY

# 빌드툴 제거로 이미지 슬림화
RUN apt-get purge -y --auto-remove gcc build-essential && \
    rm -rf /var/lib/apt/lists/*

# 전체 프로젝트 복사
#COPY . .
# 소스/매핑/설정 복사
COPY ./src ./src
COPY ./mappings ./mappings
COPY gunicorn.conf.py ./gunicorn.conf.py
COPY README.md ./

# 개발 dev: gunicorn + --reload (코드 변경 자동반영), 단일 워커
# gunicorn -w 1 --threads 2 --reload -b 0.0.0.0:5000 app:app
# 운영 prod: gunicorn 설정파일 사용(멀티 워커/프리로드/타임아웃 등)
# gunicorn -c gunicorn.conf.py app:app
# RUN_MODE에 따라 CMD 스위치
CMD ["sh","-c","if [ \"$RUN_MODE\" = \"dev\" ]; then \
  exec gunicorn -w 1 --threads 2 --reload -b 0.0.0.0:5000 app:app; \
  else exec gunicorn -c gunicorn.conf.py app:app; fi"]