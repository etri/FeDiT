
# Elasticsearch
ES_URL=http://{elasticsearch ip}:9200
ES_USERNAME={elastic_user}
ES_PASSWORD={elastic_pw}
ES_INDEX_NAME=dtmeta_vector
ES_EDGES_INDEX_NAME=dtmeta_edges
ES_REQUEST_TIMEOUT=30
ES_MAX_RETRIES=3
ES_RETRY_ON_TIMEOUT=true
# TLS 인증서 검증 수행 여부 (운영 SSL 시에만 true)
ES_VERIFY_CERTS=false

# 임베딩 모델
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# TODO OpenAI API 사용시 비용 청구됨. 
OPENAI_API_KEY={open_api_key}

# RAG
LLM_SUMMARY_LIMIT=10
ES_TOP_K=100
OPENAI_CHAT_MODEL=gpt-4o-mini

# 인증서버 public key
OAUTH_PUBLIC_KEY_URL=http://{server ip}:33000/security/publickey