# 인증 서버 설정값
#
# 이 파일을 .env 로 복사한 뒤 값을 채워 사용한다.
#   cp .env.example .env
#   docker run --env-file .env ...
#
# 값을 지정하지 않으면 server_conf.js 의 기본값(아래 주석의 값)이 쓰인다.
# 따옴표는 값의 일부로 취급되므로 붙이지 않는다.

# --- 서버 주소 -------------------------------------------------------------
# 브라우저가 접속하는 이 서버의 주소. 기본값 localhost
SERVER_HOST=

# 인증 서버 포트. 기본값 33000
SECURITY_PORT=

# 로그인 후 돌아갈 웹 주소. 기본값 http://localhost:8084
# DB(application.redirect_uri)에 넣은 값과 반드시 같아야 한다.
WEB_SERVER_URL=

# --- 데이터베이스 ----------------------------------------------------------
# 컨테이너에서 호스트 PostgreSQL 로 나가는 도커 게이트웨이. 기본값 172.25.0.1
DB_HOST=
# 기본값 5432
DB_PORT=
# 기본값 hubsecurity
HUBSECURITY_DBNAME=
# 기본값 hubsecurity_manager
HUBSECURITY_USERNAME=
# 기본값 rhksflwk1!
HUBSECURITY_PASSWORD=

# --- 메일 발송 (사용할 때만) ------------------------------------------------
MAIL_ACCOUNT_ID=
MAIL_ACCOUNT_PWD=
MAIL_SEND_URL=
